    "settings.this_application_uses_tmdb_and" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App nutzt TMDB und die TMDB-APIs, wird aber von TMDB weder unterstützt, zertifiziert noch anderweitig genehmigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This application uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta aplicación usa TMDB y las API de TMDB, pero no está respaldada, certificada ni aprobada de otro modo por TMDB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application utilise TMDB et les API TMDB, mais n’est ni approuvée, ni certifiée, ni autrement validée par TMDB."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi ini menggunakan TMDB dan API TMDB tetapi tidak didukung, disertifikasi, atau disetujui oleh TMDB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa applicazione utilizza TMDB e le API di TMDB ma non è sostenuta, certificata né in alcun altro modo approvata da TMDB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリケーションはTMDBおよびTMDB APIを使用していますが、TMDBによる推奨、認定、その他の承認を受けたものではありません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta aplikacja korzysta z TMDB i interfejsów API TMDB, ale nie jest wspierana, certyfikowana ani w żaden inny sposób zatwierdzona przez TMDB."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este aplicativo usa o TMDB e as APIs do TMDB, mas não é endossado, certificado nem aprovado de outra forma pelo TMDB."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это приложение использует TMDB и API TMDB, но не одобрено, не сертифицировано и не поддерживается TMDB."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulama TMDB'yi ve TMDB API'lerini kullanır ancak TMDB tarafından onaylanmamış, sertifikalandırılmamış veya başka şekilde yetkilendirilmemiştir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng này sử dụng TMDB và các API của TMDB nhưng không được TMDB xác nhận, chứng nhận hay phê duyệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
