    "jellyfin.in_the_jellyfin_dashboard_open" : {
      "comment" : "JellyfinConnectView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne im Jellyfin-Dashboard „Bibliotheken“ und füge einen Ordner mit Serien oder Filmen hinzu. Benenne Folgen etwa „Serienname/Season 01/Serienname S01E01.mkv“, damit Jellyfin sie zuordnen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the Jellyfin dashboard, open Libraries and add a folder of shows or movies. Name episodes like \"Show Name/Season 01/Show Name S01E01.mkv\" so Jellyfin can match them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el panel de Jellyfin, abre Bibliotecas y añade una carpeta de series o películas. Nombra los episodios como \"Nombre de la serie/Season 01/Nombre de la serie S01E01.mkv\" para que Jellyfin pueda reconocerlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans le tableau de bord Jellyfin, ouvrez Bibliothèques et ajoutez un dossier de séries ou de films. Nommez les épisodes comme « Nom de la série/Season 01/Nom de la série S01E01.mkv » pour que Jellyfin puisse les reconnaître."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di dasbor Jellyfin, buka Pustaka lalu tambahkan folder berisi serial atau film. Beri nama episode seperti \"Nama Serial/Season 01/Nama Serial S01E01.mkv\" agar Jellyfin dapat mencocokkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella dashboard di Jellyfin apri Librerie e aggiungi una cartella di serie o film. Dai agli episodi nomi come \"Nome serie/Season 01/Nome serie S01E01.mkv\" così Jellyfin può riconoscerli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfinダッシュボードで「ライブラリ」を開き、番組または映画のフォルダを追加します。Jellyfinが照合できるよう、エピソードは「Show Name/Season 01/Show Name S01E01.mkv」のように命名してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W panelu Jellyfin otwórz Biblioteki i dodaj folder z serialami lub filmami. Nazywaj odcinki według wzoru „Nazwa serialu/Season 01/Nazwa serialu S01E01.mkv”, aby Jellyfin mógł je dopasować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No painel do Jellyfin, abra Bibliotecas e adicione uma pasta de séries ou filmes. Nomeie os episódios como \"Nome da Série/Season 01/Nome da Série S01E01.mkv\" para que o Jellyfin consiga identificá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В панели управления Jellyfin откройте «Медиатеки» и добавьте папку с сериалами или фильмами. Называйте серии так: «Название/Season 01/Название S01E01.mkv», чтобы Jellyfin мог их распознать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin panelinde Kitaplıklar'ı açın ve dizi ya da film klasörü ekleyin. Jellyfin'in eşleştirebilmesi için bölümleri “Dizi Adı/Season 01/Dizi Adı S01E01.mkv” gibi adlandırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong bảng điều khiển Jellyfin, hãy mở Thư viện và thêm một thư mục chứa chương trình hoặc phim. Đặt tên các tập theo dạng \"Show Name/Season 01/Show Name S01E01.mkv\" để Jellyfin có thể khớp chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Jellyfin 控制面板中，打开“媒体库”并添加一个包含剧集或电影的文件夹。请将剧集命名为“Show Name/Season 01/Show Name S01E01.mkv”这样的格式，以便 Jellyfin 进行匹配。"
          }
        }
      }
    },
