    },
    "library.simkl_gives_specials_no_season" : {
      "comment" : "SimklTitlePage",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl vergibt für Specials keine Staffel- oder Folgennummer, daher können sie hier weder abgespielt noch markiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl gives specials no season or episode number, so they can't be played or marked from here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl no asigna número de temporada ni de episodio a los especiales, así que no se pueden reproducir ni marcar desde aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl n’attribue aucun numéro de saison ni d’épisode aux épisodes spéciaux ; ils ne peuvent donc pas être lus ni marqués ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl tidak memberi episode spesial nomor musim atau episode, sehingga tidak dapat diputar atau ditandai dari sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl non assegna agli speciali un numero di stagione o di episodio, quindi da qui non si possono riprodurre né segnare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simklでは特別編にシーズン番号やエピソード番号がないため、ここから再生したりマークしたりできません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl nie nadaje odcinkom specjalnym numeru sezonu ani odcinka, więc nie można ich stąd odtwarzać ani oznaczać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Simkl não atribui temporada nem número de episódio aos especiais, então eles não podem ser reproduzidos nem marcados daqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl не присваивает спецвыпускам номер сезона или серии, поэтому их нельзя воспроизвести или отметить отсюда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl özel bölümlere sezon veya bölüm numarası vermez, bu yüzden buradan oynatılamaz veya işaretlenemezler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl không gán số mùa hoặc số tập cho các tập đặc biệt, nên không thể phát hay đánh dấu chúng từ đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl 没有为特别篇提供季或集编号，因此无法在此播放或标记。"
          }
        }
      }
    },
