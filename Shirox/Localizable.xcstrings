    "settings.progress_library_settings_and_modules" : {
      "comment" : "BackupSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortschritt, Mediathek, Einstellungen und Module. Keine Login-Tokens, daher kannst du die Datei bedenkenlos teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progress, library, settings and modules. No login tokens, so the file is safe to share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progreso, biblioteca, ajustes y módulos. Sin tokens de inicio de sesión, así que el archivo se puede compartir sin riesgo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progression, bibliothèque, réglages et modules. Aucun jeton de connexion, le fichier peut donc être partagé sans risque."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progres, pustaka, pengaturan, dan modul. Tanpa token login, sehingga file aman dibagikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progresso, libreria, impostazioni e moduli. Nessun token di accesso, quindi il file si può condividere in sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進捗、ライブラリ、設定、モジュール。ログイントークンは含まれないため、ファイルは安全に共有できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postęp, biblioteka, ustawienia i moduły. Bez tokenów logowania, więc plik można bezpiecznie udostępniać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progresso, biblioteca, ajustes e módulos. Sem tokens de login, então o arquivo é seguro para compartilhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогресс, медиатека, настройки и модули. Без токенов входа, поэтому файлом можно безопасно делиться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlerleme, kitaplık, ayarlar ve modüller. Oturum jetonu yok, bu yüzden dosyayı paylaşmak güvenlidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiến độ, thư viện, cài đặt và mô-đun. Không có mã thông báo đăng nhập, nên tệp này an toàn để chia sẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度、资料库、设置和模块。不含登录令牌，因此文件可以安全分享。"
          }
        }
      }
    },
