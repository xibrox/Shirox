    "settings.discord_shown_note" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Titel wird immer angezeigt. Schalte diese aus, um weniger zu teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The title is always shown. Turn these off to share less."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El título siempre se muestra. Desactiva estas opciones para compartir menos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le titre est toujours affiché. Désactivez ces options pour partager moins."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
