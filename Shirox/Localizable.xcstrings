    "settings.pauses_while_control_center_or" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert, solange das Kontrollzentrum oder die Mitteilungszentrale geöffnet ist, und setzt fort, wenn du sie schließt. Beim Verlassen der App oder Sperren des Telefons läuft die Wiedergabe weiter im Hintergrund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauses while Control Center or Notification Center is open and picks up again when you close it. Leaving the app or locking the phone still plays in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pausa mientras el Centro de control o el Centro de notificaciones están abiertos y continúa al cerrarlos. Salir de la app o bloquear el teléfono sigue reproduciendo en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met en pause tant que le centre de contrôle ou le centre de notifications est ouvert et reprend à sa fermeture. Quitter l’app ou verrouiller l’iPhone continue de lire en arrière-plan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dijeda saat Pusat Kontrol atau Pusat Notifikasi terbuka dan dilanjutkan saat Anda menutupnya. Keluar dari app atau mengunci ponsel tetap memutar di latar belakang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va in pausa mentre Centro di Controllo o Centro Notifiche è aperto e riprende quando lo chiudi. Uscire dall'app o bloccare l'iPhone continua a riprodurre in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールセンターまたは通知センターを開いている間は一時停止し、閉じると再開します。Appを離れたりiPhoneをロックしたりした場合は、引き続きバックグラウンドで再生されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymuje, gdy Centrum sterowania lub Centrum powiadomień jest otwarte, i wznawia po jego zamknięciu. Opuszczenie aplikacji lub zablokowanie telefonu nadal odtwarza w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa enquanto a Central de Controle ou a Central de Notificações estiver aberta e retoma quando você a fecha. Sair do app ou bloquear o celular ainda reproduz em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставит на паузу, пока открыт Пункт управления или Центр уведомлений, и продолжает, когда вы его закроете. При выходе из приложения или блокировке телефона воспроизведение в фоне продолжается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denetim Merkezi veya Bildirim Merkezi açıkken duraklar ve kapattığınızda devam eder. Uygulamadan çıkmak veya telefonu kilitlemek yine de arka planda oynatır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạm dừng khi Trung tâm điều khiển hoặc Trung tâm thông báo đang mở và tiếp tục khi bạn đóng. Rời khỏi ứng dụng hoặc khóa iPhone vẫn phát trong nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在控制中心或通知中心打开时暂停，关闭后继续播放。离开 App 或锁定手机仍会在后台播放。"
          }
        }
      }
    },
