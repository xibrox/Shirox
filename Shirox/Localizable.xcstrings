    "settings.tap_sides_to_scroll_or" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seiten tippen zum Scrollen oder Blättern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Sides to Scroll or Turn"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca los lados para desplazar o pasar de página"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toucher les côtés pour faire défiler ou tourner la page"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk Sisi untuk Menggulir atau Membalik"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca i lati per scorrere o voltare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "側面をタップしてスクロール/ページをめくる"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij boki, aby przewijać lub przewracać strony"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocar nas laterais para rolar ou virar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Касание по краям для прокрутки или перелистывания"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydırmak veya Çevirmek İçin Kenarlara Dokun"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào cạnh để cuộn hoặc lật trang"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按两侧滚动或翻页"
          }
        }
      }
    },
    "settings.tap_the_right_side_to" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe rechts, um nach unten zu scrollen oder zur nächsten Seite zu blättern, links, um zurückzugehen; Lesen von rechts nach links tauscht die Seiten. Die Mitte blendet die Bedienelemente ein und aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the right side to scroll down or turn to the next page, the left to go back; right to left reading swaps them. The middle shows and hides the controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el lado derecho para desplazarte hacia abajo o pasar a la página siguiente, y el izquierdo para volver; la lectura de derecha a izquierda los intercambia. El centro muestra y oculta los controles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le côté droit pour faire défiler vers le bas ou passer à la page suivante, le côté gauche pour revenir en arrière ; la lecture de droite à gauche les inverse. Le milieu affiche et masque les commandes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk sisi kanan untuk menggulir ke bawah atau membalik ke halaman berikutnya, sisi kiri untuk kembali; membaca kanan ke kiri menukarnya. Bagian tengah menampilkan dan menyembunyikan kontrol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il lato destro per scorrere in basso o passare alla pagina successiva, quello sinistro per tornare indietro; la lettura da destra a sinistra li inverte. Il centro mostra e nasconde i controlli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右側をタップすると下にスクロールするか次のページに進み、左側をタップすると戻ります。右から左への読み方では逆になります。中央をタップすると、コントロールの表示/非表示が切り替わります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij prawą stronę, aby przewinąć w dół lub przejść do następnej strony, a lewą, aby wrócić; czytanie od prawej do lewej zamienia je miejscami. Środek pokazuje i ukrywa elementy sterujące."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no lado direito para rolar para baixo ou ir à próxima página e no esquerdo para voltar; a leitura da direita para a esquerda os inverte. O meio mostra e oculta os controles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь правой стороны, чтобы прокрутить вниз или перейти на следующую страницу, и левой, чтобы вернуться; при чтении справа налево они меняются местами. Середина показывает и скрывает элементы управления."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aşağı kaydırmak veya sonraki sayfaya geçmek için sağ tarafa, geri dönmek için sola dokunun; sağdan sola okuma bunları değiştirir. Orta kısım denetimleri gösterir ve gizler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào bên phải để cuộn xuống hoặc sang trang tiếp theo, bên trái để quay lại; chế độ đọc từ phải sang trái sẽ đảo ngược. Phần giữa hiện và ẩn các nút điều khiển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按右侧向下滚动或翻到下一页，点按左侧则返回；从右到左阅读时两者对调。点按中间可显示或隐藏控制项。"
          }
        }
      }
    },
