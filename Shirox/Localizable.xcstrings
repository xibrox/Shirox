    "settings.every_downloaded_episode_and_chapter" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle geladenen Folgen und Kapitel werden von diesem Gerät entfernt. Du kannst sie später erneut laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every downloaded episode and chapter will be removed from this device. You can download them again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán de este dispositivo todos los episodios y capítulos descargados. Podrás descargarlos de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
