          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta fonte é protegida pelo Cloudflare. Verifique para carregar os streams."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот источник защищён Cloudflare. Пройдите проверку, чтобы загрузить потоки."
