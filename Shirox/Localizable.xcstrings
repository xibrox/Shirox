          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni episodio e capitolo scaricato verrà rimosso da questo dispositivo. Potrai scaricarli di nuovo più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みのすべてのエピソードとチャプターがこのデバイスから削除されます。あとで再ダウンロードできます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie pobrane odcinki i rozdziały zostaną usunięte z tego urządzenia. Możesz pobrać je ponownie później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os episódios e capítulos baixados serão removidos deste dispositivo. Você poderá baixá-los de novo depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
