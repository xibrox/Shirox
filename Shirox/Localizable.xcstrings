    "jellyfin.make_sure_the_server_is" : {
      "comment" : "JellyfinConnectView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle sicher, dass der Server läuft und die Firewall deines Computers Port 8096 zulässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the server is running and your computer's firewall allows port 8096."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que el servidor esté en marcha y de que el cortafuegos de tu ordenador permita el puerto 8096."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que le serveur est en cours d’exécution et que le pare-feu de votre ordinateur autorise le port 8096."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastikan server berjalan dan firewall komputer Anda mengizinkan port 8096."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che il server sia in esecuzione e che il firewall del tuo computer consenta la porta 8096."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバが起動していて、コンピュータのファイアウォールでポート8096が許可されていることを確認してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upewnij się, że serwer działa, a zapora komputera zezwala na port 8096."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se o servidor está em execução e se o firewall do seu computador permite a porta 8096."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что сервер запущен, а брандмауэр компьютера разрешает порт 8096."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucunun çalıştığından ve bilgisayarınızın güvenlik duvarının 8096 numaralı bağlantı noktasına izin verdiğinden emin olun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy đảm bảo máy chủ đang chạy và tường lửa của máy tính cho phép cổng 8096."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确保服务器正在运行，并且电脑的防火墙允许使用端口 8096。"
          }
        }
      }
    },
    "jellyfin.open_in_safari_mac" : {
      "comment" : "JellyfinConnectView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne dieselbe Adresse in Safari auf deinem Mac. Lädt sie dort nicht, liegt es am Netzwerk, nicht an der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the same address in Safari on your Mac. If it doesn't load there, it's the network, not the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la misma dirección en Safari en tu Mac. Si no carga ahí, el problema es la red, no la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez la même adresse dans Safari sur votre Mac. Si elle ne se charge pas, le problème vient du réseau, pas de l’app."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka alamat yang sama di Safari di Mac Anda. Jika tidak termuat di sana, masalahnya ada di jaringan, bukan aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri lo stesso indirizzo in Safari sul tuo Mac. Se lì non si carica, il problema è la rete, non l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MacのSafariで同じアドレスを開いてください。そこでも読み込めない場合は、アプリではなくネットワークの問題です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz ten sam adres w Safari na Macu. Jeśli się nie wczytuje, problem leży w sieci, a nie w aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o mesmo endereço no Safari do seu Mac. Se não carregar lá, o problema é a rede, não o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте тот же адрес в Safari на вашем Mac. Если он не загружается и там, проблема в сети, а не в приложении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı adresi Mac'inizde Safari'de açın. Orada da yüklenmiyorsa sorun uygulamada değil, ağdadır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở cùng địa chỉ đó trong Safari trên máy Mac của bạn. Nếu không tải được ở đó, nguyên nhân là mạng chứ không phải ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 Mac 上的 Safari 中打开相同的地址。如果在那里也无法载入，则问题出在网络，而不是 App。"
          }
        }
      }
    },
