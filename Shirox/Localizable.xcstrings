        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiêu đề này đã được liên kết với AniList và không có phần tiếp theo, phần trước hay phần ngoại truyện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此作品已关联到 AniList，没有续集、前传或外传。"
          }
        }
      }
