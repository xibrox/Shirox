    "library.hides_this_entry_from_your" : {
      "comment" : "LibraryEntryEditSheet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet diesen Eintrag in deinem öffentlichen AniList-Profil und Aktivitätsfeed aus. Hier siehst du ihn weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hides this entry from your public AniList profile and activity feed. You can still see it here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta esta entrada de tu perfil público y de tu actividad en AniList. Sigues viéndola aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque cette entrée de votre profil AniList public et de votre fil d’activité. Vous la voyez toujours ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyembunyikan entri ini dari profil AniList publik dan umpan aktivitas Anda. Anda tetap dapat melihatnya di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde questa voce dal tuo profilo AniList pubblico e dal feed delle attività. Qui continui a vederla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエントリをAniListの公開プロフィールとアクティビティフィードに表示しません。ここでは引き続き表示されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrywa ten wpis w Twoim publicznym profilu AniList i w aktywności. Nadal widzisz go tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta esta entrada do seu perfil público e do feed de atividades do AniList. Você ainda a vê aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает эту запись из вашего публичного профиля и ленты активности AniList. Здесь вы по-прежнему её видите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu girdiyi herkese açık AniList profilinizden ve etkinlik akışınızdan gizler. Yine de burada görebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẩn mục này khỏi hồ sơ AniList công khai và bảng hoạt động của bạn. Bạn vẫn có thể thấy mục này ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的 AniList 公开资料和动态中隐藏此条目。你仍可在此处看到它。"
          }
        }
      }
    },
