    "settings.missing_yours_open_an_issue" : {
      "comment" : "GeneralSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine fehlt? Eröffne ein Issue auf GitHub; Übersetzungen sind auch willkommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Missing yours? Open an issue on GitHub; translations are welcome too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Falta el tuyo? Abre una incidencia en GitHub; las traducciones también son bienvenidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque la vôtre ? Ouvrez un ticket sur GitHub ; les traductions sont aussi les bienvenues."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa Anda belum ada? Buka isu di GitHub; terjemahan juga diterima."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca la tua? Apri una issue su GitHub; sono benvenute anche le traduzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いの言語がありませんか？GitHubでIssueを作成してください。翻訳のご協力も歓迎します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje Twojego języka? Otwórz zgłoszenie w serwisie GitHub; tłumaczenia też są mile widziane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não encontrou o seu? Abra uma issue no GitHub; traduções também são bem-vindas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет вашего языка? Создайте issue на GitHub; переводы тоже приветствуются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizinki eksik mi? GitHub'da bir issue açın; çeviriler de memnuniyetle karşılanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiếu ngôn ngữ của bạn? Hãy mở một issue trên GitHub; bản dịch cũng luôn được chào đón."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有你的语言？请在 GitHub 上提交 issue；也欢迎贡献翻译。"
          }
        }
      }
    },
