          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Änderungen werden verworfen und das eigene Skript des Moduls wird erneut geladen. Updates werden fortgesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your edits are thrown away and the module's own script is downloaded again. Updates resume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus ediciones se descartan y se vuelve a descargar el script del propio módulo. Se reanudan las actualizaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos modifications sont supprimées et le script propre au module est téléchargé à nouveau. Les mises à jour reprennent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasil edit Anda dibuang dan skrip asli modul diunduh kembali. Pembaruan dilanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue modifiche vengono eliminate e lo script del modulo viene scaricato di nuovo. Gli aggiornamenti riprendono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集内容は破棄され、モジュール自身のスクリプトが再ダウンロードされます。アップデートが再開されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje zmiany zostaną odrzucone, a oryginalny skrypt modułu zostanie pobrany ponownie. Aktualizacje zostaną wznowione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas edições são descartadas e o script do próprio módulo é baixado novamente. As atualizações são retomadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши изменения будут отброшены, а собственный скрипт модуля скачается заново. Обновления возобновятся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenlemeleriniz atılır ve modülün kendi komut dosyası yeniden indirilir. Güncellemeler devam eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các chỉnh sửa của bạn sẽ bị bỏ và tập lệnh gốc của mô-đun sẽ được tải xuống lại. Bản cập nhật sẽ tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的编辑内容将被丢弃，并重新下载模块自带的脚本。更新将恢复。"
          }
        }
      }
    },
