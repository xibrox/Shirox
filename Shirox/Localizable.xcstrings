    "settings.icon_packs_note" : {
      "comment" : "GeneralSettingsView, Icon Packs",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Symbole, mit denen Shirox seine Tasten und Zeilen zeichnet. SF Symbols ist eingebaut und lässt sich nicht entfernen; wische oder halte ein Paket, um es zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The symbols Shirox draws its buttons and rows with. SF Symbols is built in and can't be removed; swipe or hold a pack to remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los símbolos con los que Shirox dibuja sus botones y filas. SF Symbols está integrado y no se puede quitar; los paquetes añadidos por enlace sí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les symboles avec lesquels Shirox dessine ses boutons et ses rangées. SF Symbols est intégré et ne peut pas être retiré ; les packs ajoutés par lien le peuvent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simbol yang digunakan Shirox untuk menggambar tombol dan barisnya. SF Symbols sudah tersedia dan tidak dapat dihapus; paket yang ditambahkan lewat tautan dapat dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I simboli con cui Shirox disegna i suoi pulsanti e le sue righe. SF Symbols è integrato e non può essere rimosso; i pacchetti aggiunti tramite link sì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shiroxがボタンや行の描画に使用するシンボルです。SF Symbolsは内蔵されており削除できません。リンクで追加したパックは削除できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbole, którymi Shirox rysuje swoje przyciski i wiersze. SF Symbols są wbudowane i nie można ich usunąć; pakiety dodane przez link można."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os símbolos com que o Shirox desenha seus botões e linhas. O SF Symbols é integrado e não pode ser removido; os pacotes adicionados por link podem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Символы, которыми Shirox рисует кнопки и строки. SF Symbols встроены и не могут быть удалены; наборы, добавленные по ссылке, — могут."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox'un düğmelerini ve satırlarını çizdiği semboller. SF Symbols yerleşiktir ve kaldırılamaz; bağlantıyla eklenen paketler kaldırılabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ký hiệu mà Shirox dùng để vẽ nút và hàng. SF Symbols được tích hợp sẵn và không thể gỡ; các gói thêm bằng liên kết thì có thể."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox 用来绘制按钮和行的符号。SF Symbols 内置且无法移除；通过链接添加的图标包可以移除。"
          }
        }
      }
    },
