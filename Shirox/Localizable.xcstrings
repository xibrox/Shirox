        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta fuente está protegida por Cloudflare. Verifica para cargar los streams."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette source est protégée par Cloudflare. Vérifiez pour charger les flux."
