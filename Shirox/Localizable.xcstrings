    "modules.required_the_modules_javascript_from" : {
      "comment" : "ModuleImportView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erforderlich. Das JavaScript des Moduls, aus einer .js-Datei oder im Editor geschrieben: was es sucht, auflistet und abspielt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Required. The module's JavaScript, from a .js file or written in the editor: what it searches, lists and plays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obligatorio. El JavaScript del módulo, de un archivo .js o escrito en el editor: lo que busca, lista y reproduce."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obligatoire. Le JavaScript du module, issu d’un fichier .js ou écrit dans l’éditeur : ce qu’il recherche, liste et lit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wajib. JavaScript modul, dari file .js atau ditulis di editor: apa yang dicari, didaftar, dan diputarnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obbligatorio. Il JavaScript del modulo, da un file .js o scritto nell'editor: cosa cerca, elenca e riproduce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必須。.jsファイルまたはエディタで記述した、モジュールのJavaScriptです。検索、一覧表示、再生の内容を定義します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymagane. JavaScript modułu, z pliku .js lub napisany w edytorze: co wyszukuje, wyświetla i odtwarza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrigatório. O JavaScript do módulo, de um arquivo .js ou escrito no editor: o que ele busca, lista e reproduz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
