    "modules.stream_your_own_jellyfin_server" : {
      "comment" : "ModuleListView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streame von deinem eigenen Jellyfin-Server – durchsuche deine Mediathek, mach dort weiter, wo du aufgehört hast, und synchronisiere den Ansehstatus zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream your own Jellyfin server — browse your library, resume where you left off, and sync watch state back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce tu propio servidor Jellyfin: explora tu biblioteca, reanuda donde lo dejaste y sincroniza el estado de visualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diffusez votre propre serveur Jellyfin — parcourez votre bibliothèque, reprenez là où vous vous étiez arrêté et resynchronisez l’état de visionnage."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streaming dari server Jellyfin Anda sendiri — jelajahi pustaka, lanjutkan dari terakhir ditonton, dan sinkronkan status tontonan kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai lo streaming del tuo server Jellyfin: sfoglia la libreria, riprendi da dove avevi lasciato e sincronizza lo stato di visione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のJellyfinサーバからストリーミング — ライブラリの閲覧、続きから再生、視聴状況の同期ができます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesyłaj ze swojego serwera Jellyfin — przeglądaj bibliotekę, wznawiaj od miejsca przerwania i synchronizuj stan oglądania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmita seu próprio servidor Jellyfin — navegue pela biblioteca, retome de onde parou e sincronize o estado de visualização de volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите со своего сервера Jellyfin: просматривайте медиатеку, продолжайте с того места, где остановились, и синхронизируйте статус просмотра."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi Jellyfin sunucunuzdan yayın yapın — kitaplığınıza göz atın, kaldığınız yerden devam edin ve izleme durumunu geri senkronlayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phát trực tuyến từ máy chủ Jellyfin của riêng bạn — duyệt thư viện, tiếp tục từ chỗ đang xem dở và đồng bộ trạng thái xem trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "串流你自己的 Jellyfin 服务器 — 浏览资料库、从上次停下的位置继续观看，并将观看状态同步回去。"
          }
        }
      }
    },
