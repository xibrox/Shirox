    "settings.shirox_switches_language_the_next" : {
      "comment" : "GeneralSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox wechselt die Sprache beim nächsten Öffnen. Schließe die App im App-Umschalter, um sofort zu wechseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox switches language the next time it opens. Close it from the app switcher to switch now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox cambia de idioma la próxima vez que se abra. Ciérralo desde el selector de apps para cambiarlo ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox change de langue à sa prochaine ouverture. Fermez-le depuis le sélecteur d’apps pour changer maintenant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox berganti bahasa saat dibuka berikutnya. Tutup dari pengalih app untuk beralih sekarang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox cambia lingua alla prossima apertura. Chiudilo dal selettore app per cambiarla subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shiroxの言語は、次回の起動時に切り替わります。今すぐ切り替えるには、Appスイッチャーで終了してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox zmieni język przy następnym otwarciu. Zamknij go w przełączniku aplikacji, aby zmienić teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shirox muda de idioma na próxima vez que for aberto. Feche-o no seletor de apps para mudar agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox переключит язык при следующем открытии. Закройте приложение в переключателе приложений, чтобы переключить сейчас."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox dili bir sonraki açılışta değiştirir. Şimdi değiştirmek için uygulama değiştiriciden kapatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox đổi ngôn ngữ vào lần mở tiếp theo. Hãy đóng ứng dụng từ trình chuyển đổi ứng dụng để đổi ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox 会在下次打开时切换语言。从 App 切换器中关闭它即可立即切换。"
          }
        }
      }
    },
