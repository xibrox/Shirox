    "settings.replaces_https_api_themoviedb_org" : {
      "comment" : "AdvancedNetworkSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt https://api.themoviedb.org und https://image.tmdb.org; Pfad, Query und Schlüssel werden mitgegeben. TMDB-Verkehr geht dann nur noch dorthin, und nur an eine gültige https-Adresse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replaces https://api.themoviedb.org and https://image.tmdb.org; the path, query and key go along. TMDB traffic then goes only there, and only to a valid https address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplaza https://api.themoviedb.org y https://image.tmdb.org; la ruta, la consulta y la clave se mantienen. El tráfico de TMDB va entonces solo allí, y solo a una dirección https válida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace https://api.themoviedb.org et https://image.tmdb.org ; le chemin, la requête et la clé suivent. Le trafic TMDB passe alors uniquement par là, et uniquement vers une adresse https valide."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengganti https://api.themoviedb.org dan https://image.tmdb.org; path, query, dan kunci ikut dikirim. Lalu lintas TMDB kemudian hanya menuju ke sana, dan hanya ke alamat https yang valid."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisce https://api.themoviedb.org e https://image.tmdb.org; percorso, query e chiave vengono inoltrati. Il traffico TMDB va poi solo lì, e solo a un indirizzo https valido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "https://api.themoviedb.orgとhttps://image.tmdb.orgを置き換えます。パス、クエリ、キーはそのまま引き継がれます。TMDBの通信はそこにのみ送られ、有効なhttpsアドレスにのみ送られます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastępuje https://api.themoviedb.org i https://image.tmdb.org; ścieżka, zapytanie i klucz zostają przekazane. Ruch TMDB trafia wtedy tylko tam i tylko na prawidłowy adres https."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitui https://api.themoviedb.org e https://image.tmdb.org; o caminho, a consulta e a chave vão junto. O tráfego do TMDB então vai somente para lá, e somente para um endereço https válido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменяет https://api.themoviedb.org и https://image.tmdb.org; путь, запрос и ключ передаются дальше. Тогда трафик TMDB идёт только туда и только на допустимый адрес https."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "https://api.themoviedb.org ve https://image.tmdb.org adreslerini değiştirir; yol, sorgu ve anahtar da gider. TMDB trafiği o zaman yalnızca oraya gider ve yalnızca geçerli bir https adresine."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay thế https://api.themoviedb.org và https://image.tmdb.org; đường dẫn, truy vấn và khóa được giữ kèm theo. Khi đó lưu lượng TMDB chỉ đi đến đó, và chỉ đến địa chỉ https hợp lệ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "替换 https://api.themoviedb.org 和 https://image.tmdb.org；路径、查询和密钥会一并带上。TMDB 流量随后只会发往那里，并且仅发往有效的 https 地址。"
          }
        }
      }
    },
    "settings.replaces_the_progress_library_settings" : {
      "comment" : "BackupSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt Fortschritt, Mediathek, Einstellungen und Module auf diesem Gerät durch die aus dem Backup. Geladene Folgen und Kapitel bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replaces the progress, library, settings and modules on this device with the ones in the backup. Downloaded episodes and chapters are left alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplaza el progreso, la biblioteca, los ajustes y los módulos de este dispositivo por los de la copia de seguridad. Los episodios y capítulos descargados no se tocan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace la progression, la bibliothèque, les réglages et les modules de cet appareil par ceux de la sauvegarde. Les épisodes et chapitres téléchargés ne sont pas touchés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengganti progres, pustaka, pengaturan, dan modul di perangkat ini dengan yang ada di cadangan. Episode dan bab yang diunduh tidak disentuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisce progresso, libreria, impostazioni e moduli su questo dispositivo con quelli del backup. Gli episodi e i capitoli scaricati non vengono toccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの進捗、ライブラリ、設定、モジュールを、バックアップの内容に置き換えます。ダウンロード済みのエピソードとチャプターはそのまま残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastępuje postęp, bibliotekę, ustawienia i moduły na tym urządzeniu tymi z kopii zapasowej. Pobrane odcinki i rozdziały pozostają bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitui o progresso, a biblioteca, os ajustes e os módulos deste dispositivo pelos do backup. Os episódios e capítulos baixados não são afetados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменяет прогресс, медиатеку, настройки и модули на этом устройстве данными из резервной копии. Загруженные серии и главы не затрагиваются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıttaki ilerlemeyi, kitaplığı, ayarları ve modülleri yedekteki ile değiştirir. İndirilen bölümlere dokunulmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay thế tiến độ, thư viện, cài đặt và mô-đun trên thiết bị này bằng nội dung trong bản sao lưu. Các tập và chương đã tải xuống được giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用备份中的进度、资料库、设置和模块替换此设备上的内容。已下载的剧集和章节不受影响。"
          }
        }
      }
    },
