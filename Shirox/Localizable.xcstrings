    "settings.pulling_down_still_refreshes_with" : {
      "comment" : "GeneralSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herunterziehen aktualisiert weiterhin, ohne dass etwas angezeigt wird: ein Tippen, wenn du weit genug gezogen hast, ein weiteres, wenn es fertig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulling down still refreshes, with nothing on screen: a tap when you've pulled far enough, another when it's done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirar hacia abajo sigue actualizando, sin nada en pantalla: un toque cuando has tirado lo suficiente y otro cuando termina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirer vers le bas actualise toujours, sans rien afficher à l’écran : un toucher quand vous avez assez tiré, un autre quand c’est terminé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menarik ke bawah tetap memuat ulang, tanpa tampilan apa pun di layar: satu ketukan saat Anda menarik cukup jauh, satu lagi saat selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascinare verso il basso aggiorna comunque, senza nulla sullo schermo: un tocco quando hai trascinato abbastanza, un altro quando ha finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下に引っ張ると、画面には何も表示されずに更新されます。十分に引っ張ったときと完了したときに、それぞれタップ感が伝わります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pociągnięcie w dół nadal odświeża, bez niczego na ekranie: stuknięcie, gdy pociągniesz wystarczająco daleko, i kolejne po zakończeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puxar para baixo ainda atualiza, sem nada na tela: um toque quando você puxou o bastante e outro quando terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потягивание вниз по-прежнему обновляет, но без индикатора на экране: касание, когда вы потянули достаточно далеко, и ещё одно, когда обновление завершено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aşağı çekmek yine yeniler, ekranda hiçbir şey olmadan: yeterince çektiğinizde bir dokunuş, bittiğinde bir dokunuş daha."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo xuống vẫn làm mới, không hiện gì trên màn hình: một lần chạm khi bạn đã kéo đủ xa, một lần nữa khi hoàn tất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下拉仍会刷新，但屏幕上不显示任何内容：下拉到足够距离时轻点一次，完成时再轻点一次。"
          }
        }
      }
    },
    "settings.pulling_stretches_a_drop_out" : {
      "comment" : "GeneralSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Ziehen dehnt sich ein Tropfen aus der Dynamic Island, der das Ladesymbol trägt."
          }
        },
        "en" : {
