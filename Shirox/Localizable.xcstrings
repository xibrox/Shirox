    "modules.watch_video_files_from_your" : {
      "comment" : "ModuleListView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir Videodateien von deinem Mac an – inklusive Untertitel, Bild-in-Bild und „Weiterschauen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch video files from your Mac — subtitles, Picture in Picture, and Continue Watching included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve archivos de vídeo de tu Mac, con subtítulos, imagen en imagen y Continuar viendo incluidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez des fichiers vidéo depuis votre Mac — sous-titres, Picture in Picture et Reprendre la lecture inclus."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonton file video dari Mac Anda — termasuk subtitel, Picture in Picture, dan Lanjutkan Menonton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda i file video dal tuo Mac: sottotitoli, Picture in Picture e Continua a guardare inclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macのビデオファイルを視聴 — 字幕、ピクチャ・イン・ピクチャ、「続きを見る」に対応しています。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oglądaj pliki wideo z Maca — z napisami, funkcją Obraz w obrazie i Kontynuuj oglądanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assista a arquivos de vídeo do seu Mac — com legendas, Picture in Picture e Continuar Assistindo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите видеофайлы со своего Mac — с субтитрами, режимом «Картинка в картинке» и функцией «Продолжить просмотр»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac'inizdeki video dosyalarını izleyin — altyazılar, Picture in Picture ve İzlemeye Devam Et dahil."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem tệp video từ máy Mac của bạn — bao gồm phụ đề, Hình trong hình và Tiếp tục xem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "观看 Mac 上的视频文件 — 支持字幕、画中画和“继续观看”。"
          }
        }
      }
    },
