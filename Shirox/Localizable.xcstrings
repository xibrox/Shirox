    "library.youre_signed_in_but_hasnt %@" : {
      "comment" : "LibraryView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist angemeldet, aber %@ hat dein Profil noch nicht gesendet. Meist bedeutet das, dass die API gerade ausgefallen ist – dein Konto ist in Ordnung und wird ergänzt, sobald der Dienst wieder erreichbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're signed in, but %@ hasn't sent your profile yet. This usually means its API is down — your account is fine, and it'll fill in once the service is reachable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has iniciado sesión, pero %@ aún no ha enviado tu perfil. Normalmente significa que su API no funciona: tu cuenta está bien y se completará cuando el servicio vuelva a estar disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes connecté, mais %@ n’a pas encore envoyé votre profil. Cela signifie généralement que son API est en panne — votre compte n’est pas en cause, et il se remplira dès que le service sera de nouveau joignable."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sudah masuk, tetapi %@ belum mengirim profil Anda. Biasanya ini berarti API-nya sedang bermasalah — akun Anda baik-baik saja dan akan terisi setelah layanan dapat dijangkau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai effettuato l'accesso, ma %@ non ha ancora inviato il tuo profilo. Di solito significa che la sua API non funziona: il tuo account è a posto e si aggiornerà non appena il servizio sarà di nuovo raggiungibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインしていますが、%@からプロフィールがまだ送信されていません。通常はAPIが停止していることを意味します。アカウントに問題はなく、サービスが復旧すれば反映されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś zalogowany, ale %@ nie przesłał jeszcze Twojego profilu. Zwykle oznacza to awarię jego API — Twoje konto jest w porządku i profil uzupełni się, gdy usługa znów będzie dostępna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está conectado, mas %@ ainda não enviou seu perfil. Isso geralmente significa que a API dele está fora do ar — sua conta está bem e será preenchida assim que o serviço voltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход выполнен, но %@ ещё не прислал ваш профиль. Обычно это значит, что его API недоступен — с вашей учётной записью всё в порядке, данные появятся, когда сервис снова заработает."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş yaptınız, ancak %@ henüz profilinizi göndermedi. Bu genellikle API'sinin çalışmadığı anlamına gelir — hesabınız sorunsuz ve hizmete ulaşılabildiğinde dolacaktır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã đăng nhập, nhưng %@ chưa gửi hồ sơ của bạn. Điều này thường có nghĩa là API của dịch vụ đang gặp sự cố — tài khoản của bạn vẫn ổn và hồ sơ sẽ hiện ra khi dịch vụ hoạt động trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已登录，但 %@ 尚未发送你的个人资料。这通常意味着其 API 暂时不可用 — 你的账户没有问题，服务恢复后会自动补全。"
          }
        }
      }
    },
