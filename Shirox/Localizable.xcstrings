    "settings.marks_shows_youre_watching_that" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiert Serien, die du gerade schaust und die ausgestrahlte Folgen haben, die du noch nicht gesehen hast – mit einem Punkt für die, die seit deinem letzten Öffnen der Serie erschienen sind. Sortiere im Sortiermenü der Mediathek nach „Neue Folgen zuerst“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marks shows you're watching that have aired episodes you haven't seen, with a dot for ones that came out since you last opened the show. Sort by New Episodes First from the Library's sort menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca las series que estás viendo y tienen episodios emitidos que no has visto, con un punto para los que salieron desde la última vez que abriste la serie. Ordena por Episodios nuevos primero en el menú de orden de la biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque les séries que vous regardez dont des épisodes diffusés ne sont pas encore vus, avec un point pour ceux sortis depuis la dernière ouverture de la série. Triez par « Nouveaux épisodes d’abord » depuis le menu de tri de la bibliothèque."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menandai serial yang sedang Anda tonton yang memiliki episode tayang yang belum Anda lihat, dengan titik untuk yang rilis sejak terakhir kali Anda membuka serial itu. Urutkan menurut Episode Baru Dulu dari menu urutan Pustaka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segna le serie che stai guardando con episodi andati in onda che non hai visto, con un punto per quelli usciti dall'ultima volta che hai aperto la serie. Ordina per Prima i nuovi episodi dal menu di ordinamento della Libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未視聴の放送済みエピソードがある視聴中の番組にマークを付け、前回番組を開いてから公開されたものにはドットを表示します。ライブラリの並べ替えメニューで「新しいエピソード順」を選択してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznacza oglądane seriale, które mają wyemitowane odcinki, których jeszcze nie obejrzano, kropką przy tych, które ukazały się od ostatniego otwarcia serialu. Sortuj według Najpierw nowe odcinki w menu sortowania Biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca séries que você está assistindo com episódios exibidos que você ainda não viu, com um ponto para os lançados desde a última vez que você abriu a série. Ordene por Novos episódios primeiro no menu de ordenação da Biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечает сериалы, которые вы смотрите и у которых вышли непросмотренные серии, точкой — те, что вышли с момента, когда вы последний раз открывали сериал. Сортируйте по «Сначала новые серии» в меню сортировки медиатеки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlediğiniz dizilerden henüz görmediğiniz yayınlanmış bölümleri olanları, diziyi en son açtığınızdan beri çıkanlar için bir noktayla işaretler. Kitaplığın sıralama menüsünden Yeni Bölümler Önce'ye göre sıralayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh dấu các chương trình bạn đang xem có tập đã phát sóng mà bạn chưa xem, kèm chấm cho những tập ra mắt kể từ lần cuối bạn mở chương trình. Sắp xếp theo Tập mới trước từ menu sắp xếp của Thư viện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标记你正在观看且有未看过的已播出剧集的作品，自你上次打开该作品后新发布的会带一个圆点。可在资料库的排序菜单中选择“新剧集在前”排序。"
          }
        }
      }
    },
