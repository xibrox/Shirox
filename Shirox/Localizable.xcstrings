          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca + para crear una colección y luego añade títulos desde tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez + pour créer une collection, puis ajoutez-y des titres depuis votre bibliothèque."
