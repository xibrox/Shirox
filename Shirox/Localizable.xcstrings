    "player.the_current_video_frame_is" : {
      "comment" : "PlayerView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das aktuelle Videobild ist nicht verfügbar. Versuche es erneut, während das Video läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current video frame is unavailable. Try again while the video is playing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fotograma actual del vídeo no está disponible. Inténtalo de nuevo mientras se reproduce el vídeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image actuelle de la vidéo n’est pas disponible. Réessayez pendant la lecture de la vidéo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bingkai video saat ini tidak tersedia. Coba lagi saat video sedang diputar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fotogramma attuale del video non è disponibile. Riprova mentre il video è in riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のビデオフレームを取得できません。ビデオの再生中にもう一度お試しください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bieżąca klatka wideo jest niedostępna. Spróbuj ponownie podczas odtwarzania wideo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O quadro atual do vídeo não está disponível. Tente de novo enquanto o vídeo estiver sendo reproduzido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущий кадр видео недоступен. Повторите попытку во время воспроизведения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli video karesi kullanılamıyor. Video oynatılırken tekrar deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khung hình video hiện tại không khả dụng. Hãy thử lại khi video đang phát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前视频画面不可用。请在视频播放时重试。"
          }
        }
      }
    },
