    "settings.lets_ios_play_videos_in" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt iOS Videos in 3D-Audio mit seiner Filmklangverarbeitung auf AirPods und anderen Kopfhörern abspielen. Schalte es für normales Stereo aus oder wenn Kopfhörer hier leiser spielen als in anderen Apps. Gilt ab dem nächsten Video."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets iOS play videos in Spatial Audio, with its movie sound processing, on AirPods and other headphones. Turn off for plain stereo, or if headphones play quieter here than in other apps. Takes effect from the next video."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que iOS reproduzca vídeos con Audio espacial, con su procesamiento de sonido de cine, en AirPods y otros auriculares. Desactívalo para estéreo normal, o si los auriculares suenan más bajo aquí que en otras apps. Se aplica desde el próximo vídeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à iOS de lire les vidéos en audio spatial, avec son traitement sonore cinéma, sur les AirPods et d’autres casques. Désactivez pour du stéréo simple, ou si les casques sont moins forts ici que dans d’autres apps. Prend effet à partir de la prochaine vidéo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memungkinkan iOS memutar video dalam Spatial Audio, dengan pemrosesan suara filmnya, di AirPods dan headphone lain. Matikan untuk stereo biasa, atau jika headphone terdengar lebih pelan di sini daripada di app lain. Berlaku mulai video berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente a iOS di riprodurre i video con Audio spaziale, con la sua elaborazione audio cinematografica, su AirPods e altre cuffie. Disattiva per lo stereo normale, o se le cuffie suonano più piano qui che in altre app. Ha effetto dal video successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPodsなどのヘッドフォンで、映画用のサウンド処理を備えた空間オーディオでビデオを再生できるようにします。通常のステレオで再生する場合や、ここでの音量が他のアプリより小さい場合はオフにしてください。次のビデオから有効になります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala systemowi iOS odtwarzać wideo z dźwiękiem przestrzennym i jego przetwarzaniem dźwięku filmowego na AirPods i innych słuchawkach. Wyłącz, aby uzyskać zwykłe stereo lub jeśli słuchawki grają tutaj ciszej niż w innych aplikacjach. Zacznie obowiązywać od następnego wideo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que o iOS reproduza vídeos em Áudio Espacial, com o processamento de som de cinema, em AirPods e outros fones. Desative para estéreo simples ou se os fones soarem mais baixo aqui do que em outros apps. Vale a partir do próximo vídeo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет iOS воспроизводить видео с пространственным аудио и обработкой звука для фильмов в AirPods и других наушниках. Выключите для обычного стерео или если в наушниках здесь тише, чем в других приложениях. Вступает в силу со следующего видео."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS'un videoları AirPods ve diğer kulaklıklarda film ses işlemesiyle Uzamsal Ses ile oynatmasını sağlar. Düz stereo için veya kulaklıklar burada diğer uygulamalardan daha kısık çalıyorsa kapatın. Bir sonraki videodan itibaren geçerli olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép iOS phát video bằng Âm thanh không gian, với xử lý âm thanh phim, trên AirPods và các tai nghe khác. Hãy tắt để dùng âm thanh stereo thường, hoặc nếu tai nghe phát nhỏ hơn ở đây so với các ứng dụng khác. Có hiệu lực từ video tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 iOS 在 AirPods 和其他耳机上以空间音频及其影院声音处理播放视频。关闭后为普通立体声，或在耳机在此处比在其他 App 中声音更小时关闭。下一个视频起生效。"
          }
        }
      }
    },
