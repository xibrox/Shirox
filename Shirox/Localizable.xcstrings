        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah dia memberimu petunjuk,\nkoordinat, atau apa pun?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti ha dato qualche indizio,\nqualche coordinata, qualcosa?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "彼は何か手がかりを\n座標でも、何でも？"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy dał ci jakieś wskazówki,\njakieś współrzędne, cokolwiek?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele deu alguma pista,\nalguma coordenada, qualquer coisa?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он дал вам хоть какие-то подсказки,\nкоординаты, хоть что-нибудь?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana ipucu verdi mi,\nkoordinat falan, herhangi bir şey?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ông ấy có cho bạn manh mối nào không,\ntọa độ nào không, bất cứ thứ gì?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他有没有给你什么线索，\n什么坐标，任何东西？"
          }
        }
      }
    },
