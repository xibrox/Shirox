    "settings.discord_application_id_note" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Discord-Anwendung von Shirox. Ändere sie nur für eine eigene Anwendung mit aktiviertem Social SDK, als öffentlicher Client mit der Weiterleitung shirox://discord."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox's Discord application. Change it only for an application of your own with the Social SDK turned on, as a public client with the redirect shirox://discord."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación de Discord de Shirox. Cámbiala solo por una aplicación propia con el Social SDK activado, como cliente público con la redirección shirox://discord."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’application Discord de Shirox. Ne la modifiez que pour une application qui vous appartient, avec le Social SDK activé, en tant que client public avec la redirection shirox://discord."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi Discord milik Shirox. Ubah hanya untuk aplikasi milikmu sendiri dengan Social SDK diaktifkan, sebagai klien publik dengan pengalihan shirox://discord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’applicazione Discord di Shirox. Modificala solo per un’applicazione tua con il Social SDK attivo, come client pubblico con il reindirizzamento shirox://discord."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ShiroxのDiscordアプリケーション。Social SDKを有効にした自分のアプリケーション（リダイレクトshirox://discordのパブリッククライアント）にする場合のみ変更してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Discord Shirox. Zmieniaj ją tylko na własną aplikację z włączonym Social SDK, jako klienta publicznego z przekierowaniem shirox://discord."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aplicativo do Discord do Shirox. Altere-o somente para um aplicativo seu com o Social SDK ativado, como cliente público com o redirecionamento shirox://discord."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение Discord для Shirox. Меняйте его только на собственное приложение с включённым Social SDK, как публичный клиент с перенаправлением shirox://discord."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox'un Discord uygulaması. Yalnızca Social SDK'sı açık, shirox://discord yönlendirmesine sahip herkese açık bir istemci olan kendi uygulamanız için değiştirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng Discord của Shirox. Chỉ thay đổi khi dùng ứng dụng của riêng bạn đã bật Social SDK, ở dạng ứng dụng khách công khai với chuyển hướng shirox://discord."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox 的 Discord 应用程序。仅在使用已开启 Social SDK 的自有应用程序时更改，且需设为公共客户端，重定向为 shirox://discord。"
          }
        }
      }
    },
