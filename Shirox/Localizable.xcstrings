    "settings.set_while_watching_from_the" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird beim Ansehen über den Untertitel-Button festgelegt. Gilt auch für das nächste Video, bis du es zurücksetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set while watching, from the subtitles button. It carries over to the next video until you reset it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se establece al ver, desde el botón de subtítulos. Se mantiene en el siguiente vídeo hasta que lo restablezcas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défini pendant la lecture, depuis le bouton des sous-titres. Il est conservé pour la vidéo suivante jusqu’à ce que vous le réinitialisiez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diatur saat menonton, dari tombol subtitel. Berlaku untuk video berikutnya hingga Anda mengatur ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si imposta durante la visione, dal pulsante dei sottotitoli. Vale anche per il video successivo finché non lo reimposti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴中に字幕ボタンから設定します。リセットするまで、次のビデオにも引き継がれます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawiane podczas oglądania, przyciskiem napisów. Obowiązuje także w następnym wideo, dopóki go nie zresetujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definido durante a reprodução, pelo botão de legendas. Vale para o próximo vídeo até você redefinir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задаётся во время просмотра кнопкой субтитров. Сохраняется для следующего видео, пока вы не сбросите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlerken altyazılar düğmesinden ayarlanır. Siz sıfırlayana kadar sonraki videoya taşınır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt khi đang xem, từ nút phụ đề. Giá trị này được giữ cho video tiếp theo cho đến khi bạn đặt lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "观看时通过字幕按钮设定。它会延续到下一个视频，直到你重置它。"
          }
        }
      }
    },
    "settings.settings" : {
