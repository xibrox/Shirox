        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa sorgente è protetta da Cloudflare. Verifica per caricare gli stream."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このソースはCloudflareで保護されています。確認してストリームを読み込んでください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
