        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップに保存されているアカウントにも、このデバイスでサインインします。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loguje też to urządzenie do kont zapisanych w kopii zapasowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também conecta este dispositivo às contas salvas no backup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также выполняется вход на этом устройстве в учётные записи, сохранённые в резервной копии."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıca bu aygıtta yedekte kayıtlı hesaplarda oturum açar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này cũng đăng nhập thiết bị này vào các tài khoản đã lưu trong bản sao lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它还会让此设备登录备份中保存的账户。"
          }
        }
      }
    },
    "settings.keep_the_reader_upright_turn" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält den Reader aufrecht. Schalte es aus, um quer zu lesen, wenn du dein Telefon drehst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the reader upright. Turn off to read sideways when you turn your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene el lector en vertical. Desactívalo para leer de lado al girar el teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde le lecteur à la verticale. Désactivez pour lire en mode horizontal lorsque vous tournez votre iPhone."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaga pembaca tetap tegak. Matikan untuk membaca menyamping saat Anda memutar ponsel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni il lettore in verticale. Disattiva per leggere in orizzontale quando ruoti l'iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リーダーを縦向きに固定します。オフにすると、iPhoneを回転させて横向きで読めます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuj czytnik w pionie. Wyłącz, aby czytać w poziomie po obróceniu telefonu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém o leitor na vertical. Desative para ler de lado ao girar o celular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранять читалку в вертикальной ориентации. Выключите, чтобы читать в горизонтальной ориентации при повороте телефона."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okuyucuyu dik tutun. Telefonunuzu çevirdiğinizde yan okumak için kapatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ trình đọc thẳng đứng. Hãy tắt để đọc nghiêng khi bạn xoay iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持阅读器竖直。关闭后，转动手机即可横向阅读。"
          }
        }
      }
    },
    "settings.keeps_a_video_playing_when" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt ein Video weiter, wenn du die App verlässt. Aus pausiert es, außer es läuft in Bild-in-Bild, über AirPlay oder auf einem Fernseher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps a video playing when you leave the app. Off, it pauses, unless it's in Picture in Picture, on AirPlay or cast to a TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene un vídeo en reproducción al salir de la app. Desactivado, se pausa, salvo en imagen en imagen, en AirPlay o enviado a una tele."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintient la lecture d’une vidéo lorsque vous quittez l’app. Désactivé, elle se met en pause, sauf en Picture in Picture, sur AirPlay ou diffusée sur une TV."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjaga video tetap diputar saat Anda meninggalkan app. Jika nonaktif, video dijeda, kecuali dalam Picture in Picture, di AirPlay, atau di-cast ke TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene in riproduzione un video quando esci dall'app. Se disattivato, va in pausa, a meno che non sia in Picture in Picture, su AirPlay o trasmesso a una TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appを離れてもビデオの再生を続けます。オフにすると一時停止します。ただし、ピクチャ・イン・ピクチャ、AirPlay、テレビへのキャストの場合を除きます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrzymuje odtwarzanie wideo po opuszczeniu aplikacji. Po wyłączeniu wideo jest wstrzymywane, chyba że działa w trybie Obraz w obrazie, przez AirPlay lub jest przesyłane na telewizor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém um vídeo em reprodução ao sair do app. Desativado, ele pausa, a menos que esteja em Picture in Picture, no AirPlay ou transmitido para uma TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжает воспроизведение видео при выходе из приложения. Если выключено, видео ставится на паузу, кроме случаев, когда оно в режиме «Картинка в картинке», на AirPlay или транслируется на телевизор."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamadan çıktığınızda videonun oynamaya devam etmesini sağlar. Kapalıyken, Picture in Picture'da, AirPlay'de veya bir TV'ye yayında değilse duraklar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ video tiếp tục phát khi bạn rời khỏi ứng dụng. Khi tắt, video sẽ tạm dừng, trừ khi đang ở chế độ Hình trong hình, trên AirPlay hoặc được truyền lên TV."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开 App 时让视频继续播放。关闭后会暂停，除非处于画中画、AirPlay 或投放到电视。"
          }
        }
      }
    },
