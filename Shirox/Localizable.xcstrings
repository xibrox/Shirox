    "settings.signs_shirox_out_of_websites" : {
      "comment" : "AdvancedNetworkSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet Shirox von Websites ab und vergisst gelöste Cloudflare-Prüfungen; Module bitten dich eventuell erneut um Bestätigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signs Shirox out of websites and forgets solved Cloudflare checks; modules may ask you to verify again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra la sesión de Shirox en los sitios web y olvida las comprobaciones de Cloudflare resueltas; los módulos pueden pedirte que verifiques de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconnecte Shirox des sites web et oublie les vérifications Cloudflare résolues ; les modules peuvent vous demander de vérifier à nouveau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengeluarkan Shirox dari situs web dan melupakan pemeriksaan Cloudflare yang telah diselesaikan; modul mungkin meminta Anda memverifikasi lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnette Shirox dai siti web e dimentica le verifiche Cloudflare risolte; i moduli potrebbero chiederti di verificare di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebサイトからShiroxをサインアウトし、解決済みのCloudflare確認を消去します。モジュールが再度確認を求める場合があります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wylogowuje Shirox ze stron internetowych i zapomina rozwiązane weryfikacje Cloudflare; moduły mogą poprosić o ponowną weryfikację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconecta o Shirox dos sites e esquece as verificações do Cloudflare resolvidas; os módulos podem pedir nova verificação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполняет выход Shirox из веб-сайтов и забывает пройденные проверки Cloudflare; модули могут снова попросить вас пройти проверку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox'un web sitelerindeki oturumunu kapatır ve çözülmüş Cloudflare denetimlerini unutur; modüller yeniden doğrulama isteyebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng xuất Shirox khỏi các trang web và quên các lần kiểm tra Cloudflare đã giải; mô-đun có thể yêu cầu bạn xác minh lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 Shirox 退出网站登录并忘记已完成的 Cloudflare 验证；模块可能会要求你再次验证。"
          }
        }
      }
    },
