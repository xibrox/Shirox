    "settings.checks_tmdbs_api_and_images" : {
      "comment" : "AdvancedNetworkSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft die API und Bilder von TMDB, dann verschlüsseltes DNS und den Proxy, falls aktiv, und fragt Cloudflare, welche Adresse es sieht. Änderungen an DNS und Proxy gelten nach einem Neustart."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks TMDB's API and images, then encrypted DNS and the proxy if they're on, asking Cloudflare which address it sees. DNS and proxy changes apply after a restart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la API y las imágenes de TMDB, luego el DNS cifrado y el proxy si están activados, preguntando a Cloudflare qué dirección ve. Los cambios de DNS y proxy se aplican tras reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie l’API et les images de TMDB, puis le DNS chiffré et le proxy s’ils sont activés, en demandant à Cloudflare quelle adresse il voit. Les changements de DNS et de proxy s’appliquent après un redémarrage."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memeriksa API dan gambar TMDB, lalu DNS terenkripsi dan proxy jika aktif, dengan menanyakan ke Cloudflare alamat mana yang terlihat. Perubahan DNS dan proxy berlaku setelah dimulai ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla l'API e le immagini di TMDB, poi il DNS cifrato e il proxy se attivi, chiedendo a Cloudflare quale indirizzo vede. Le modifiche a DNS e proxy si applicano dopo un riavvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TMDBのAPIと画像を確認し、オンの場合は暗号化DNSとプロキシも確認します。その際、Cloudflareに見えているアドレスを問い合わせます。DNSとプロキシの変更は再起動後に反映されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdza API i obrazy TMDB, a następnie szyfrowany DNS i serwer proxy, jeśli są włączone, pytając Cloudflare, jaki adres widzi. Zmiany DNS i serwera proxy zaczną obowiązywać po ponownym uruchomieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica a API e as imagens do TMDB e, se estiverem ativados, o DNS criptografado e o proxy, perguntando à Cloudflare qual endereço ela enxerga. As alterações de DNS e proxy valem após reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяет API и изображения TMDB, затем зашифрованный DNS и прокси, если они включены, спрашивая у Cloudflare, какой адрес он видит. Изменения DNS и прокси применяются после перезапуска."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TMDB'nin API'sini ve resimlerini, ardından açıksa şifreli DNS'i ve proxy'yi denetler; Cloudflare'a hangi adresi gördüğünü sorar. DNS ve proxy değişiklikleri yeniden başlatmadan sonra uygulanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra API và hình ảnh của TMDB, sau đó là DNS mã hóa và proxy nếu đang bật, bằng cách hỏi Cloudflare xem nó thấy địa chỉ nào. Các thay đổi DNS và proxy có hiệu lực sau khi khởi động lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查 TMDB 的 API 和图片，然后（若已开启）检查加密 DNS 和代理，并询问 Cloudflare 它看到的地址。DNS 和代理的更改在重新启动后生效。"
          }
        }
      }
    },
    "settings.choose_which_log_categories_to" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, welche Log-Kategorien aufgezeichnet werden. Debug und HTMLStrings können sehr ausführlich sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which log categories to record. Debug and HTMLStrings can be very verbose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué categorías de registro guardar. Debug y HTMLStrings pueden ser muy extensas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
