    "library.tap_to_create_a_collection" : {
      "comment" : "ManageCollectionsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf +, um eine Sammlung zu erstellen, und füge ihr dann Titel aus deiner Mediathek hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
