    "settings.how_far_your_finger_may" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit dein Finger abweichen darf, bevor ein Halten erkannt wird. Erhöhe den Wert, wenn die Halte-Aktion immer wieder abbricht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How far your finger may drift before a hold is recognized. Raise it if the hold action keeps cancelling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto puede desplazarse tu dedo antes de que se reconozca una pulsación prolongada. Auméntalo si la acción sigue cancelándose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance maximale sur laquelle votre doigt peut dériver avant qu’un maintien soit reconnu. Augmentez-la si l’action de maintien est sans cesse annulée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seberapa jauh jari Anda boleh bergeser sebelum tahan dikenali. Naikkan jika aksi tahan terus dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto può spostarsi il dito prima che venga riconosciuta una pressione prolungata. Aumentala se l'azione di pressione prolungata continua ad annullarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しとして認識されるまでに指が動いてよい距離です。長押しアクションが繰り返しキャンセルされる場合は、値を大きくしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak daleko może przesunąć się palec, zanim przytrzymanie zostanie rozpoznane. Zwiększ tę wartość, jeśli akcja przytrzymania stale się anuluje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto o dedo pode se deslocar antes de um toque longo ser reconhecido. Aumente se a ação de segurar continuar sendo cancelada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько может сместиться палец, прежде чем удержание будет распознано. Увеличьте, если действие при удержании постоянно отменяется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basılı tutma algılanmadan önce parmağınızın ne kadar kayabileceği. Basılı tutma eylemi sürekli iptal oluyorsa artırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngón tay bạn có thể lệch bao xa trước khi nhận diện thao tác nhấn giữ. Hãy tăng giá trị này nếu hành động nhấn giữ liên tục bị hủy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手指在被识别为长按之前可以移动的距离。如果长按操作总是被取消，请调高此值。"
          }
        }
      }
    },
