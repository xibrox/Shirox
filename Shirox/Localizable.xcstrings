    "modules.paste_replaces_editor" : {
      "comment" : "ModuleImportView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles im Editor wird durch den Inhalt deiner Zwischenablage ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything in the editor is replaced with what's on your clipboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el contenido del editor se sustituye por lo que hay en tu portapapeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le contenu de l’éditeur est remplacé par le contenu de votre presse-papiers."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua isi editor akan diganti dengan isi papan klip Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il contenuto dell'editor viene sostituito con quello che hai negli appunti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディタの内容はすべて、クリップボードの内容に置き換えられます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Całą zawartość edytora zastąpi to, co masz w schowku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo no editor é substituído pelo que está na sua área de transferência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё содержимое редактора будет заменено содержимым буфера обмена."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenleyicideki her şey panonuzdaki içerikle değiştirilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi nội dung trong trình soạn thảo sẽ được thay bằng nội dung trong bảng nhớ tạm của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑器中的所有内容都将被替换为你剪贴板上的内容。"
          }
        }
      }
    },
    "modules.paste_replaces_editor_detail" : {
      "comment" : "ModuleScriptEditorView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles im Editor wird gelöscht und durch den Inhalt deiner Zwischenablage ersetzt. Ein fehlerhaftes Skript sorgt dafür, dass dieses Modul nicht mehr funktioniert. Nichts wird übernommen, bis du auf „Sichern“ tippst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything in the editor is deleted and replaced with what's on your clipboard. A broken script stops this module from working. Nothing is kept until you tap Save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el contenido del editor se elimina y se sustituye por lo que hay en tu portapapeles. Un script defectuoso hace que este módulo deje de funcionar. No se guarda nada hasta que toques Guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le contenu de l’éditeur est supprimé et remplacé par le contenu de votre presse-papiers. Un script défectueux empêche ce module de fonctionner. Rien n’est conservé tant que vous n’avez pas touché Enregistrer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua isi editor akan dihapus dan diganti dengan isi papan klip Anda. Skrip yang rusak membuat modul ini berhenti berfungsi. Tidak ada yang disimpan sampai Anda mengetuk Simpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il contenuto dell'editor viene eliminato e sostituito con quello che hai negli appunti. Uno script difettoso impedisce a questo modulo di funzionare. Non viene conservato nulla finché non tocchi Salva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディタの内容はすべて削除され、クリップボードの内容に置き換えられます。スクリプトが壊れていると、このモジュールは動作しなくなります。「保存」をタップするまで何も保持されません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cała zawartość edytora zostanie usunięta i zastąpiona tym, co masz w schowku. Uszkodzony skrypt uniemożliwia działanie tego modułu. Nic nie zostanie zachowane, dopóki nie stukniesz Zachowaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo no editor é apagado e substituído pelo que está na sua área de transferência. Um script com defeito impede o funcionamento deste módulo. Nada é mantido até você tocar em Salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё содержимое редактора будет удалено и заменено содержимым буфера обмена. Неисправный скрипт нарушит работу этого модуля. Ничего не сохраняется, пока вы не нажмёте «Сохранить»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenleyicideki her şey silinir ve panonuzdaki içerikle değiştirilir. Bozuk bir komut dosyası bu modülün çalışmasını durdurur. Kaydet'e dokunana kadar hiçbir şey saklanmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi nội dung trong trình soạn thảo sẽ bị xóa và thay bằng nội dung trong bảng nhớ tạm của bạn. Một tập lệnh bị lỗi sẽ khiến mô-đun này ngừng hoạt động. Sẽ không có gì được giữ lại cho đến khi bạn chạm vào Lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑器中的所有内容都将被删除，并替换为你剪贴板上的内容。损坏的脚本会导致此模块无法工作。在你点按“保存”之前，不会保留任何内容。"
          }
        }
      }
    },
