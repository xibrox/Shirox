    "settings.this_backup_will_contain_live" : {
      "comment" : "BackupSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Backup enthält gültige Login-Tokens für AniList, MyAnimeList und Jellyfin. Jeder, der die Datei öffnet, kann sich als du anmelden – behalte sie für dich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup will contain live login tokens for AniList, MyAnimeList and Jellyfin. Anyone who opens the file can sign in as you — keep it to yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de seguridad contendrá tokens de inicio de sesión activos de AniList, MyAnimeList y Jellyfin. Cualquiera que abra el archivo puede iniciar sesión como tú: guárdalo para ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde contiendra des jetons de connexion actifs pour AniList, MyAnimeList et Jellyfin. Toute personne qui ouvre le fichier peut se connecter en votre nom — gardez-le pour vous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadangan ini akan berisi token login aktif untuk AniList, MyAnimeList, dan Jellyfin. Siapa pun yang membuka file ini dapat masuk sebagai Anda — simpan untuk diri sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo backup conterrà token di accesso attivi per AniList, MyAnimeList e Jellyfin. Chiunque apra il file può accedere come te: tienilo per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバックアップには、AniList、MyAnimeList、Jellyfinの有効なログイントークンが含まれます。ファイルを開いた人は誰でもあなたとしてサインインできるため、ご自身だけで保管してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kopia zapasowa będzie zawierać aktywne tokeny logowania do AniList, MyAnimeList i Jellyfin. Każdy, kto otworzy plik, może zalogować się jako Ty — zachowaj go dla siebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backup conterá tokens de login ativos do AniList, MyAnimeList e Jellyfin. Qualquer pessoa que abrir o arquivo poderá entrar como você — mantenha-o só para você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта резервная копия будет содержать действующие токены входа для AniList, MyAnimeList и Jellyfin. Любой, кто откроет файл, сможет войти под вашим именем — храните его в тайне."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yedek, AniList, MyAnimeList ve Jellyfin için geçerli oturum jetonları içerecek. Dosyayı açan herkes sizin adınıza giriş yapabilir — kendinizde tutun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao lưu này sẽ chứa mã thông báo đăng nhập đang hoạt động cho AniList, MyAnimeList và Jellyfin. Bất kỳ ai mở tệp đều có thể đăng nhập bằng danh nghĩa của bạn — hãy giữ riêng tư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份将包含 AniList、MyAnimeList 和 Jellyfin 的有效登录令牌。任何打开此文件的人都可以以你的身份登录 — 请妥善保管。"
          }
        }
      }
    },
