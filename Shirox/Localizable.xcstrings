    "settings.your_on_device_library_works" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Mediathek auf dem Gerät funktioniert ohne Anmeldung. Auto-Tracking hält ihre Liste „Am Schauen“ mit dem synchron, was du ansiehst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your on-device library works without signing in. Auto-track keeps its Watching list in sync with what you watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu biblioteca del dispositivo funciona sin iniciar sesión. El seguimiento automático mantiene su lista Viendo sincronizada con lo que ves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre bibliothèque sur l’appareil fonctionne sans connexion. Le suivi automatique garde sa liste En cours synchronisée avec ce que vous regardez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pustaka di perangkat Anda berfungsi tanpa masuk. Lacak otomatis menjaga daftar Menonton tetap sinkron dengan yang Anda tonton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua libreria sul dispositivo funziona senza accedere. Il tracciamento automatico mantiene sincronizzata la lista In visione con ciò che guardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス上のライブラリは、サインインなしで使えます。自動トラッキングは、視聴内容に合わせて「視聴中」リストを同期し続けます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteka na urządzeniu działa bez logowania. Automatyczne śledzenie synchronizuje listę Oglądane z tym, co oglądasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua biblioteca no dispositivo funciona sem login. O acompanhamento automático mantém a lista Assistindo sincronizada com o que você assiste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша локальная медиатека работает без входа. Автоотслеживание синхронизирует её список «Смотрю» с тем, что вы смотрите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aygıttaki kitaplığınız giriş yapmadan çalışır. Otomatik takip, İzleniyor listesini izlediklerinizle senkron tutar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư viện trên thiết bị hoạt động mà không cần đăng nhập. Tự động theo dõi giữ danh sách Đang xem đồng bộ với những gì bạn xem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的设备端资料库无需登录即可使用。“自动追踪”会使其“观看中”列表与你观看的内容保持同步。"
          }
        }
      }
    },
