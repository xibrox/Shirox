    "settings.posters_from_tvdb_carry_the" : {
      "comment" : "GeneralSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poster von TVDB enthalten den Namen der Serie, daher steht er mit dem Titel darüber doppelt da. Halte eine Karte gedrückt, um den vollen Titel zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posters from TVDB carry the show's name, so the title over them says it twice. Hold a card for its full title."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pósteres de TVDB llevan el nombre de la serie, así que el título encima lo dice dos veces. Mantén pulsada una tarjeta para ver su título completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les affiches de TVDB portent le nom de la série, si bien que le titre au-dessus le répète. Maintenez une carte pour voir son titre complet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poster dari TVDB sudah memuat nama serial, sehingga judul di atasnya terbaca dua kali. Tahan kartu untuk melihat judul lengkapnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I poster di TVDB riportano il nome della serie, quindi il titolo sopra lo ripete due volte. Tieni premuta una scheda per vedere il titolo completo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TVDBのポスターには番組名が含まれているため、その上のタイトルと重複して表示されます。カードを長押しすると完全なタイトルが表示されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plakaty z TVDB zawierają nazwę serialu, więc tytuł nad nimi powtarza ją dwa razy. Przytrzymaj kartę, aby zobaczyć pełny tytuł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pôsteres do TVDB trazem o nome da série, então o título sobre eles o repete. Segure um cartão para ver o título completo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Постеры из TVDB содержат название сериала, поэтому название над ними повторяется дважды. Удерживайте карточку, чтобы увидеть полное название."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TVDB'deki posterler dizinin adını taşır, bu yüzden üzerlerindeki başlık adı iki kez söyler. Tam başlık için bir karta basılı tutun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poster từ TVDB đã mang tên chương trình, nên tiêu đề phía trên sẽ lặp lại hai lần. Hãy nhấn giữ một thẻ để xem tiêu đề đầy đủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TVDB 的海报带有作品名称，因此其上方的标题会重复显示。按住卡片可查看完整标题。"
          }
        }
      }
    },
