    "profile.uses_the_same_modules_as %@" : {
      "comment" : "ProfilesView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzt dieselben Module wie %@: Hinzufügen, Entfernen oder Bearbeiten eines Moduls ändert beide."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the same modules as %@: adding, removing or editing one changes both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa los mismos módulos que %@: añadir, quitar o editar uno cambia ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise les mêmes modules que %@ : en ajouter, retirer ou modifier un les change pour les deux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan modul yang sama dengan %@: menambah, menghapus, atau mengedit satu modul akan mengubah keduanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa gli stessi moduli di %@: aggiungerne, rimuoverne o modificarne uno cambia entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@と同じモジュールを使用します。1つを追加・削除・編集すると、両方に反映されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa tych samych modułów co %@: dodanie, usunięcie lub edycja jednego zmienia oba."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa os mesmos módulos que %@: adicionar, remover ou editar um altera os dois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует те же модули, что и «%@»: добавление, удаление или изменение модуля влияет на оба профиля."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ile aynı modülleri kullanır: birini eklemek, kaldırmak veya düzenlemek ikisini de değiştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng chung mô-đun với %@: thêm, gỡ hoặc sửa một mô-đun sẽ thay đổi cả hai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用与 %@ 相同的模块：添加、移除或编辑其中一个会同时影响两者。"
          }
        }
      }
    },
