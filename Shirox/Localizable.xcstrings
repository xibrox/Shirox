    "settings.loads_smaller_artwork_and_skips" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt kleinere Bilder und überspringt die großen Banner auf der Startseite. Poster wirken weicher; alles funktioniert weiterhin, Downloads und Wiedergabe sind nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loads smaller artwork and skips the large banner images on Home. Posters look softer; everything still works, and downloads and playback are unaffected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga ilustraciones más pequeñas y omite los banners grandes del Inicio. Los pósteres se ven más suaves; todo sigue funcionando y las descargas y la reproducción no se ven afectadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charge des illustrations plus petites et ignore les grandes bannières de l’accueil. Les affiches sont plus floues ; tout fonctionne toujours, et les téléchargements et la lecture ne sont pas affectés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memuat gambar yang lebih kecil dan melewati gambar banner besar di Beranda. Poster tampak lebih lembut; semuanya tetap berfungsi, dan unduhan serta pemutaran tidak terpengaruh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carica immagini più piccole e salta i grandi banner nella Home. I poster appaiono più sfocati; tutto continua a funzionare, e download e riproduzione non sono interessati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "より小さいアートワークを読み込み、ホームの大きなバナー画像をスキップします。ポスターはやわらかく表示されますが、すべての機能は使え、ダウンロードと再生には影響しません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wczytuje mniejszą grafikę i pomija duże banery na ekranie głównym. Plakaty wyglądają łagodniej; wszystko nadal działa, a pobieranie i odtwarzanie pozostają bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carrega imagens menores e ignora os banners grandes no Início. Os pôsteres ficam mais suaves; tudo continua funcionando, e downloads e reprodução não são afetados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружает изображения меньшего размера и пропускает большие баннеры на главной. Постеры выглядят мягче; всё продолжает работать, а загрузки и воспроизведение не затрагиваются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha küçük kapak görselleri yükler ve Ana Sayfa'daki büyük banner görsellerini atlar. Posterler daha yumuşak görünür; her şey yine çalışır, indirmeler ve oynatma etkilenmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tải ảnh nghệ thuật nhỏ hơn và bỏ qua các ảnh biểu ngữ lớn trên Trang chủ. Poster trông mềm hơn; mọi thứ vẫn hoạt động, và việc tải xuống cùng phát lại không bị ảnh hưởng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "载入较小的海报图，并跳过主页上的大型横幅图片。海报会显得更柔和；所有功能仍可正常使用，下载和播放不受影响。"
          }
        }
      }
    },
