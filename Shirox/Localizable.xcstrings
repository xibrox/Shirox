    "profile.its_library_progress_settings_and" : {
      "comment" : "ProfilesView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Mediathek, sein Fortschritt, seine Einstellungen und Anmeldungen auf diesem Gerät werden gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its library, progress, settings and sign-ins on this device are deleted. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan su biblioteca, progreso, ajustes e inicios de sesión en este dispositivo. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa bibliothèque, sa progression, ses réglages et ses connexions sur cet appareil sont supprimés. Cette action est irréversible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pustaka, progres, pengaturan, dan info masuknya di perangkat ini akan dihapus. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua libreria, il progresso, le impostazioni e gli accessi su questo dispositivo vengono eliminati. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイス上のライブラリ、進捗、設定、サインイン情報が削除されます。この操作は取り消せません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego biblioteka, postęp, ustawienia i logowania na tym urządzeniu zostaną usunięte. Tej czynności nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A biblioteca, o progresso, os ajustes e os logins deste perfil neste dispositivo serão excluídos. Isso não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медиатека, прогресс, настройки и входы этого профиля на устройстве будут удалены. Это действие нельзя отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıttaki kitaplığı, ilerlemesi, ayarları ve oturumları silinir. Bu işlem geri alınamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư viện, tiến độ, cài đặt và các phiên đăng nhập của hồ sơ này trên thiết bị này sẽ bị xóa. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上它的资料库、进度、设置和登录信息将被删除。此操作无法撤销。"
          }
        }
      }
    },
