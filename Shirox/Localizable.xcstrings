    "settings.discord_sign_in_note" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung läuft über Discords eigene Seite; Shirox sieht dein Passwort nie. Discords Einstellung „Meine Aktivität teilen“ entscheidet weiterhin, wer es sieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in on Discord's own page; Shirox never sees your password. Discord's \"Share my activity\" setting still decides who sees it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en la propia página de Discord; Shirox nunca ve tu contraseña. El ajuste «Compartir mi actividad» de Discord sigue decidiendo quién la ve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous sur la page de Discord elle-même ; Shirox ne voit jamais votre mot de passe. Le réglage « Partager mon activité » de Discord décide toujours qui la voit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk di halaman resmi Discord; Shirox tidak pernah melihat kata sandimu. Pengaturan \"Bagikan aktivitas saya\" di Discord tetap menentukan siapa yang melihatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi sulla pagina di Discord; Shirox non vede mai la tua password. L’impostazione “Condividi la mia attività” di Discord decide comunque chi la vede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discord自身のページでサインインします。Shiroxがパスワードを見ることはありません。誰に表示されるかは、引き続きDiscordの「アクティビティを共有」設定で決まります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się na stronie Discorda; Shirox nigdy nie widzi Twojego hasła. To, kto zobaczy aktywność, nadal zależy od ustawienia Discorda „Udostępniaj moją aktywność”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre na própria página do Discord; o Shirox nunca vê sua senha. A configuração “Compartilhar minha atividade” do Discord continua decidindo quem a vê."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите на собственной странице Discord; Shirox никогда не видит ваш пароль. Настройка Discord «Делиться моей активностью» по-прежнему определяет, кто её увидит."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discord'un kendi sayfasında giriş yap; Shirox parolanı hiçbir zaman görmez. Kimlerin göreceğine yine Discord'un \"Etkinliğimi paylaş\" ayarı karar verir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập trên trang riêng của Discord; Shirox không bao giờ thấy mật khẩu của bạn. Cài đặt \"Chia sẻ hoạt động của tôi\" của Discord vẫn quyết định ai có thể thấy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Discord 自己的页面登录；Shirox 永远不会看到你的密码。谁能看到仍由 Discord 的“分享我的活动”设置决定。"
          }
        }
      }
    },
