    "shared.the_page_was_already_closed" : {
      "comment" : "ManaWebPages",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Seite war bereits geschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
