        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con Simkl: se ha guardado y se enviará más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
