    "settings.turns_subtitles_on_or_off" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet Untertitel in jedem Video ein oder aus. Der Untertitel-Button im Player ändert das ebenfalls."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns subtitles on or off in every video. The player's subtitles button changes it too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa o desactiva los subtítulos en todos los vídeos. El botón de subtítulos del reproductor también lo cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active ou désactive les sous-titres dans chaque vidéo. Le bouton des sous-titres du lecteur les modifie aussi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengaktifkan atau menonaktifkan subtitel di setiap video. Tombol subtitel pemutar juga mengubahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva o disattiva i sottotitoli in ogni video. Anche il pulsante dei sottotitoli del player li cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのビデオで字幕のオン/オフを切り替えます。プレーヤの字幕ボタンでも変更できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącza lub wyłącza napisy we wszystkich filmach. Zmienia to także przycisk napisów w odtwarzaczu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa ou desativa as legendas em todos os vídeos. O botão de legendas do player também altera isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включает или выключает субтитры во всех видео. Кнопка субтитров в плеере тоже меняет это."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altyazıları her videoda açar veya kapatır. Oynatıcının altyazı düğmesi de bunu değiştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật hoặc tắt phụ đề trong mọi video. Nút phụ đề của trình phát cũng thay đổi cài đặt này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每个视频中开启或关闭字幕。播放器的字幕按钮也可更改此项。"
          }
        }
      }
    },
    "settings.turns_the_player_to_the" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreht den Player auf die andere Querformatseite, auch wenn die Ausrichtungssperre im Kontrollzentrum aktiv ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turns the player to the other landscape side even with Rotation Lock on in Control Center."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira el reproductor al otro lado horizontal aunque el bloqueo de orientación esté activado en el Centro de control."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tourne le lecteur vers l’autre côté du paysage même si le verrouillage de l’orientation est activé dans le centre de contrôle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memutar pemutar ke sisi lanskap lainnya meskipun Kunci Rotasi aktif di Pusat Kontrol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruota il player sull'altro lato orizzontale anche con il blocco della rotazione attivo in Centro di Controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールセンターで画面の向きのロックがオンでも、プレーヤを反対側の横向きに回転します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obraca odtwarzacz na drugą stronę poziomu nawet przy włączonej blokadzie orientacji w Centrum sterowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira o player para o outro lado da horizontal mesmo com o Bloqueio de Rotação ativado na Central de Controle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поворачивает плеер на другую альбомную сторону, даже если в Пункте управления включена блокировка ориентации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denetim Merkezi'nde Dönüş Kilidi açık olsa bile oynatıcıyı diğer yatay tarafa çevirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xoay trình phát sang cạnh ngang còn lại, ngay cả khi Khóa xoay đang bật trong Trung tâm điều khiển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使在控制中心中开启了“旋转锁定”，也会将播放器转到另一侧横屏。"
          }
        }
      }
    },
