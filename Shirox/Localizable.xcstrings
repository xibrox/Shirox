        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien a répondu par l’erreur %lld. Vérifiez qu’il a été copié en entier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
