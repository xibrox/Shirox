    "shared.this_backup_was_made_by %lld %lld" : {
      "comment" : "BackupEnvelope",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Backup wurde von einer neueren Version von Shirox erstellt (Format %1$lld; diese Version liest bis %2$lld). Aktualisiere Shirox und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup was made by a newer version of Shirox (format %1$lld; this version reads up to %2$lld). Update Shirox and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de seguridad la hizo una versión más reciente de Shirox (formato %1$lld; esta versión lee hasta %2$lld). Actualiza Shirox e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde a été créée par une version plus récente de Shirox (format %1$lld ; cette version lit jusqu’à %2$lld). Mettez Shirox à jour et réessayez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadangan ini dibuat oleh versi Shirox yang lebih baru (format %1$lld; versi ini membaca hingga %2$lld). Perbarui Shirox lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo backup è stato creato da una versione più recente di Shirox (formato %1$lld; questa versione legge fino a %2$lld). Aggiorna Shirox e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバックアップは、新しいバージョンのShiroxで作成されました（形式%1$lld、このバージョンは%2$lldまで対応）。Shiroxをアップデートして、もう一度お試しください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kopia zapasowa została utworzona w nowszej wersji Shirox (format %1$lld; ta wersja odczytuje do %2$lld). Zaktualizuj Shirox i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backup foi feito por uma versão mais recente do Shirox (formato %1$lld; esta versão lê até %2$lld). Atualize o Shirox e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта резервная копия создана более новой версией Shirox (формат %1$lld; эта версия читает до %2$lld). Обновите Shirox и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yedek, Shirox'un daha yeni bir sürümüyle oluşturuldu (biçim %1$lld; bu sürüm %2$lld'e kadar okur). Shirox'u güncelleyip tekrar deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao lưu này được tạo bởi phiên bản Shirox mới hơn (định dạng %1$lld; phiên bản này đọc được đến %2$lld). Hãy cập nhật Shirox và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份由较新版本的 Shirox 创建（格式 %1$lld；此版本最高可读取 %2$lld）。请更新 Shirox 后重试。"
          }
        }
      }
    },
