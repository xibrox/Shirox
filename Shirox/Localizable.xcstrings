    "settings.styled_ass_subtitles_keep_their" : {
      "comment" : "PlayerSubtitleSettingsView, SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestaltete Untertitel (.ass) behalten ihre eigenen Schriften und Farben; Größe und Verzögerung gelten trotzdem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styled (.ass) subtitles keep their own fonts and colours; size and delay still apply."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos con estilo (.ass) conservan sus propias fuentes y colores; el tamaño y el retraso siguen aplicándose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-titres stylisés (.ass) conservent leurs propres polices et couleurs ; la taille et le décalage s’appliquent toujours."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitel bergaya (.ass) mempertahankan font dan warnanya sendiri; ukuran dan jeda tetap berlaku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sottotitoli con stile (.ass) mantengono font e colori propri; dimensione e ritardo si applicano comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スタイル付き（.ass）字幕は独自のフォントと色を保持します。サイズと遅延は引き続き適用されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisy ze stylami (.ass) zachowują własne czcionki i kolory; rozmiar i opóźnienie nadal obowiązują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As legendas estilizadas (.ass) mantêm as próprias fontes e cores; tamanho e atraso continuam valendo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стилизованные субтитры (.ass) сохраняют собственные шрифты и цвета; размер и задержка по-прежнему применяются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biçimli (.ass) altyazılar kendi yazı tiplerini ve renklerini korur; boyut ve gecikme yine de uygulanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phụ đề có kiểu (.ass) giữ phông chữ và màu riêng; cỡ chữ và độ trễ vẫn được áp dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "带样式的 (.ass) 字幕会保留其自身的字体和颜色；大小和延迟仍然适用。"
          }
        }
      }
    },
