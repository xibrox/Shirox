    "settings.the_browser_shirox_claims_to" : {
      "comment" : "AdvancedNetworkSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Browser, als der sich Shirox gegenüber Modulen, Bildern und Web-Ansichten ausgibt. Module mit eigenem und gelöste Cloudflare-Prüfungen behalten ihren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The browser Shirox claims to be for modules, images and web views. Modules with their own, and solved Cloudflare checks, keep theirs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El navegador que Shirox dice ser para módulos, imágenes y vistas web. Los módulos con el suyo propio y las comprobaciones de Cloudflare resueltas mantienen el suyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le navigateur que Shirox prétend être pour les modules, les images et les vues web. Les modules qui ont le leur, et les vérifications Cloudflare résolues, gardent le leur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browser yang diklaim Shirox untuk modul, gambar, dan tampilan web. Modul dengan milik sendiri, dan pemeriksaan Cloudflare yang telah diselesaikan, tetap memakai miliknya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il browser che Shirox dichiara di essere per moduli, immagini e viste web. I moduli con uno proprio e le verifiche Cloudflare risolte mantengono il loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shiroxがモジュール、画像、Webビューに対して名乗るブラウザです。独自のものを持つモジュールと、解決済みのCloudflare確認は、そのまま保持されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeglądarka, za którą Shirox się podaje w modułach, obrazach i widokach internetowych. Moduły z własną oraz rozwiązane weryfikacje Cloudflare zachowują swoje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O navegador que o Shirox finge ser para módulos, imagens e visualizações web. Módulos com o próprio navegador e verificações do Cloudflare resolvidas mantêm o deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Браузер, под который Shirox маскируется для модулей, изображений и веб-просмотра. Модули со своим значением и пройденные проверки Cloudflare сохраняют своё."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox'un modüller, resimler ve web görünümleri için taklit ettiği tarayıcı. Kendi tarayıcısı olan modüller ve çözülmüş Cloudflare denetimleri kendilerininkini korur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình duyệt mà Shirox giả danh cho mô-đun, hình ảnh và chế độ xem web. Các mô-đun có riêng và các lần kiểm tra Cloudflare đã giải sẽ giữ giá trị của chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox 向模块、图片和网页视图表明的浏览器身份。自带浏览器身份的模块以及已完成的 Cloudflare 验证会保留各自的身份。"
          }
        }
      }
    },
    "settings.the_buttons_at_the_top" : {
      "comment" : "GeneralSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Buttons oben auf Start und Suche: Der auf Start wählt den Anbieter, der auf Suche das Modul. Ausgeblendet behalten beide die letzte Auswahl; Module findest du auch unter Einstellungen › Module."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The buttons at the top of Home and Search: Home's picks the provider, Search's the module. Hidden, both keep the last choice; modules are also in Settings › Modules."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los botones de la parte superior de Inicio y Búsqueda: el de Inicio elige el proveedor y el de Búsqueda, el módulo. Si se ocultan, ambos conservan la última elección; los módulos también están en Ajustes › Módulos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les boutons en haut de l’accueil et de la recherche : celui de l’accueil choisit le fournisseur, celui de la recherche le module. Masqués, les deux gardent le dernier choix ; les modules se trouvent aussi dans Réglages › Modules."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol di bagian atas Beranda dan Cari: tombol Beranda memilih penyedia, tombol Cari memilih modul. Jika disembunyikan, keduanya mempertahankan pilihan terakhir; modul juga ada di Pengaturan › Modul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pulsanti in alto in Home e Cerca: quello di Home sceglie il provider, quello di Cerca il modulo. Se nascosti, entrambi mantengono l'ultima scelta; i moduli sono anche in Impostazioni › Moduli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームと検索の上部にあるボタンです。ホームではプロバイダ、検索ではモジュールを選択します。非表示にしても、どちらも最後の選択を保持します。モジュールは「設定」›「モジュール」にもあります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyciski u góry ekranu głównego i wyszukiwania: ekranu głównego wybiera dostawcę, wyszukiwania — moduł. Gdy są ukryte, oba zachowują ostatni wybór; moduły są też w Ustawienia › Moduły."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os botões no topo de Início e Buscar: o de Início escolhe o provedor; o de Buscar, o módulo. Ocultos, ambos mantêm a última escolha; os módulos também estão em Ajustes › Módulos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопки вверху «Главной» и «Поиска»: на «Главной» они выбирают провайдера, в «Поиске» — модуль. Если скрыть, обе сохраняют последний выбор; модули также есть в «Настройки» › «Модули»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Sayfa ve Ara'nın üstündeki düğmeler: Ana Sayfa'nınki sağlayıcıyı, Ara'nınki modülü seçer. Gizlendiğinde ikisi de son seçimi korur; modüller ayrıca Ayarlar › Modüller'de."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các nút ở đầu Trang chủ và Tìm kiếm: nút của Trang chủ chọn nhà cung cấp, nút của Tìm kiếm chọn mô-đun. Khi ẩn, cả hai giữ lựa chọn gần nhất; mô-đun cũng có trong Cài đặt › Mô-đun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主页和搜索顶部的按钮：主页的按钮用于选择提供者，搜索的按钮用于选择模块。隐藏后，两者都会保留上次的选择；模块也可在“设置”›“模块”中管理。"
          }
        }
      }
    },
