    "profile.deletes_s_library_progress_settings %@" : {
      "comment" : "ProfilesView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht Mediathek, Fortschritt, Einstellungen und Anmeldungen von %@ auf diesem Gerät. Die Konten selbst bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes %@'s library, progress, settings and sign-ins on this device. Accounts themselves aren't touched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina la biblioteca, el progreso, los ajustes y los inicios de sesión de %@ en este dispositivo. Las cuentas en sí no se tocan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime la bibliothèque, la progression, les réglages et les connexions de %@ sur cet appareil. Les comptes eux-mêmes ne sont pas touchés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus pustaka, progres, pengaturan, dan info masuk %@ di perangkat ini. Akun itu sendiri tidak terpengaruh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina libreria, progresso, impostazioni e accessi di %@ su questo dispositivo. Gli account stessi non vengono toccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイス上の%@のライブラリ、進捗、設定、サインイン情報を削除します。アカウント自体には影響しません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa bibliotekę, postęp, ustawienia i logowania profilu %@ na tym urządzeniu. Same konta pozostają nietknięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui a biblioteca, o progresso, os ajustes e os logins de %@ neste dispositivo. As contas em si não são afetadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут удалены медиатека, прогресс, настройки и входы профиля «%@» на этом устройстве. Сами учётные записи не затрагиваются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ profilinin bu aygıttaki kitaplığını, ilerlemesini, ayarlarını ve oturumlarını siler. Hesaplara dokunulmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa thư viện, tiến độ, cài đặt và các phiên đăng nhập của %@ trên thiết bị này. Bản thân các tài khoản không bị ảnh hưởng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除此设备上 %@ 的资料库、进度、设置和登录信息。账户本身不受影响。"
          }
        }
      }
    },
