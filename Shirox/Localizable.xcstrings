        }
      }
    },
    "library.this_removes_from_your_simkl %@" : {
      "comment" : "SimklTitleEditSheet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird %@ samt Verlauf und Bewertung aus deiner Simkl-Mediathek entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes %@ from your Simkl library, with its watch history and score."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto quita %@ de tu biblioteca de Simkl, con su historial de visualización y su puntuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela retire %@ de votre bibliothèque Simkl, avec son historique de visionnage et sa note."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghapus %@ dari pustaka Simkl Anda, beserta riwayat tontonan dan skornya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrà rimosso %@ dalla tua libreria Simkl, con la cronologia di visione e il punteggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@をSimklライブラリから削除します。視聴履歴とスコアも削除されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie %@ z Twojej biblioteki Simkl wraz z historią oglądania i oceną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove %@ da sua biblioteca do Simkl, com o histórico de visualização e a nota."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит «%@» из вашей медиатеки Simkl вместе с историей просмотров и оценкой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem, %@ öğesini izleme geçmişi ve puanıyla birlikte Simkl kitaplığınızdan kaldırır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ gỡ %@ khỏi thư viện Simkl của bạn, cùng với lịch sử xem và điểm số."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从你的 Simkl 资料库中移除“%@”，包括其观看记录和评分。"
          }
        }
      }
    },
