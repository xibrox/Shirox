    "player.frame_saved_to_photos_allow" : {
      "comment" : "PlayerView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bild in Fotos gesichert. Erlaube in den Einstellungen vollen Zugriff, um das Shirox-Album zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frame saved to Photos. Allow Full Access in Settings to use the Shirox album."
          }
