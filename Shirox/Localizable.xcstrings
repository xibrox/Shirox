    },
    "profile.starts_with_s_modules_after %@" : {
      "comment" : "ProfilesView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet mit den Modulen von %@. Danach hat jedes Profil seine eigenen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starts with %@'s modules. After that each profile's are its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con los módulos de %@. Después, los de cada perfil son independientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarre avec les modules de %@. Ensuite, chaque profil a les siens."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimulai dengan modul milik %@. Setelah itu, modul tiap profil terpisah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte con i moduli di %@. Dopodiché quelli di ogni profilo sono indipendenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のモジュールで開始します。以降は各プロフィールで個別に管理されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaczyna z modułami profilu %@. Potem moduły każdego profilu są osobne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começa com os módulos de %@. Depois disso, os de cada perfil são independentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начинается с модулей профиля «%@». Затем у каждого профиля они свои."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ profilinin modülleriyle başlar. Bundan sonra her profilin modülleri kendine aittir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu với các mô-đun của %@. Sau đó, mô-đun của mỗi hồ sơ là riêng biệt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初始使用 %@ 的模块。之后各个个人资料的模块各自独立。"
          }
        }
      }
    },
