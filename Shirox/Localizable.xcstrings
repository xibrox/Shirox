    "modules.paste_a_modules_json_link" : {
      "comment" : "ModuleListView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge den .json-Link eines Moduls, ein Stremio-Add-on oder ein Nuvio-, Vega-, SkyStream- oder Mana-Repo ein oder importiere die .js-Datei eines Moduls (und seine .json, falls du sie hast)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste a module's .json link, a Stremio addon, or a Nuvio, Vega, SkyStream or Mana repo, or import a module's .js file (and its .json, if you have it)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega el enlace .json de un módulo, un addon de Stremio o un repositorio de Nuvio, Vega, SkyStream o Mana, o importa el archivo .js de un módulo (y su .json, si lo tienes)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez le lien .json d’un module, un addon Stremio ou un dépôt Nuvio, Vega, SkyStream ou Mana, ou importez le fichier .js d’un module (et son .json, si vous l’avez)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempel tautan .json modul, addon Stremio, atau repo Nuvio, Vega, SkyStream, atau Mana, atau impor file .js modul (beserta .json-nya, jika ada)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incolla il link .json di un modulo, un addon Stremio, un repository Nuvio, Vega, SkyStream o Mana, oppure importa il file .js di un modulo (e il suo .json, se ce l'hai)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モジュールの.jsonリンク、Stremioアドオン、Nuvio・Vega・SkyStream・Manaのリポジトリをペーストするか、モジュールの.jsファイル（および.json（ある場合））を読み込んでください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklej link do pliku .json modułu, dodatek Stremio albo repozytorium Nuvio, Vega, SkyStream lub Mana, albo zaimportuj plik .js modułu (i jego plik .json, jeśli go masz)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cole o link .json de um módulo, um addon do Stremio ou um repositório Nuvio, Vega, SkyStream ou Mana, ou importe o arquivo .js de um módulo (e o .json, se tiver)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставьте ссылку на .json модуля, дополнение Stremio или репозиторий Nuvio, Vega, SkyStream или Mana либо импортируйте файл .js модуля (и его .json, если он есть)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir modülün .json bağlantısını, bir Stremio eklentisini veya bir Nuvio, Vega, SkyStream ya da Mana deposunu yapıştırın ya da bir modülün .js dosyasını (varsa .json dosyasıyla birlikte) içe aktarın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dán liên kết .json của mô-đun, một addon Stremio hoặc một repo Nuvio, Vega, SkyStream hay Mana, hoặc nhập tệp .js của mô-đun (và tệp .json của nó, nếu bạn có)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴模块的 .json 链接、Stremio 插件，或 Nuvio、Vega、SkyStream 或 Mana 仓库，或导入模块的 .js 文件（如有 .json 也一并导入）。"
          }
        }
      }
