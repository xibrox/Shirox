    "onboarding.shirox_doesnt_host_any_content" : {
      "comment" : "OnboardingView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox hostet keine Inhalte. Verbinde eine Quelle und sie wird zu deiner Mediathek – getrackt, heruntergeladen und auf diesem Gerät abgespielt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox doesn’t host any content. Connect a source and it becomes your library — tracked, downloaded and played on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox no aloja ningún contenido. Conecta una fuente y se convierte en tu biblioteca: con seguimiento, descargas y reproducción en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox n’héberge aucun contenu. Connectez une source et elle devient votre bibliothèque — suivie, téléchargée et lue sur cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox tidak menyediakan konten apa pun. Hubungkan sumber dan sumber itu menjadi pustaka Anda — dilacak, diunduh, dan diputar di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox non ospita alcun contenuto. Collega una sorgente e diventa la tua libreria: tracciata, scaricata e riprodotta su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shiroxはコンテンツを一切ホストしません。ソースを接続すると、それがあなたのライブラリになります。トラッキング、ダウンロード、再生はこのデバイスで行われます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox nie hostuje żadnych treści. Połącz źródło, a stanie się ono Twoją biblioteką — ze śledzeniem, pobieraniem i odtwarzaniem na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shirox não hospeda nenhum conteúdo. Conecte uma fonte e ela se torna sua biblioteca — acompanhada, baixada e reproduzida neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox не хранит контент. Подключите источник — и он станет вашей медиатекой: с отслеживанием, загрузками и воспроизведением на этом устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox hiçbir içerik barındırmaz. Bir kaynak bağlayın, bu aygıtta takip edilen, indirilen ve oynatılan kitaplığınız olsun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox không lưu trữ bất kỳ nội dung nào. Hãy kết nối một nguồn và nó sẽ trở thành thư viện của bạn — được theo dõi, tải xuống và phát trên thiết bị này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shirox 不托管任何内容。连接一个来源，它就会成为你的资料库 — 在此设备上追踪、下载和播放。"
          }
        }
      }
    },
