    "settings.removes_every_downloaded_episode_and" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt alle geladenen Folgen und Kapitel. Bleibt bei Cache-Zurücksetzungen außen vor – das sind Dateien, die du für die Offline-Nutzung gespeichert hast, kein Cache, den die App neu aufbauen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes every downloaded episode and chapter. Kept out of cache resets — these are files you saved for offline use, not a cache the app can rebuild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todos los episodios y capítulos descargados. No se incluye en los restablecimientos de caché: son archivos que guardaste para uso sin conexión, no una caché que la app pueda reconstruir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tous les épisodes et chapitres téléchargés. Exclus des réinitialisations de cache — ce sont des fichiers que vous avez enregistrés pour une utilisation hors ligne, pas un cache que l’app peut reconstruire."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus semua episode dan bab yang diunduh. Tidak ikut dalam pengaturan ulang cache — ini adalah file yang Anda simpan untuk penggunaan offline, bukan cache yang dapat dibangun ulang oleh app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove ogni episodio e capitolo scaricato. Esclusi dai ripristini della cache: sono file che hai salvato per l'uso offline, non una cache che l'app può ricostruire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みのすべてのエピソードとチャプターを削除します。キャッシュのリセットでは削除されません。これらはオフライン用に保存したファイルであり、アプリが再構築できるキャッシュではありません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa każdy pobrany odcinek i rozdział. Nie są objęte resetowaniem pamięci podręcznej — to pliki zapisane do użytku offline, a nie pamięć podręczna, którą aplikacja może odbudować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove todos os episódios e capítulos baixados. Fica fora das redefinições de cache — são arquivos que você salvou para uso offline, não um cache que o app possa recriar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет все загруженные серии и главы. Не затрагивается сбросом кэшей — это файлы, сохранённые для просмотра офлайн, а не кэш, который приложение может восстановить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen her bölümü kaldırır. Önbellek sıfırlamalarının dışında tutulur — bunlar çevrimdışı kullanım için kaydettiğiniz dosyalardır, uygulamanın yeniden oluşturabileceği bir önbellek değil."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gỡ mọi tập và chương đã tải xuống. Không bị xóa khi đặt lại bộ nhớ đệm — đây là các tệp bạn đã lưu để dùng ngoại tuyến, không phải bộ nhớ đệm mà ứng dụng có thể dựng lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除所有已下载的剧集和章节。不会在重置缓存时被清除 — 这些是你为离线使用而保存的文件，而不是 App 可重建的缓存。"
          }
        }
      }
    },
