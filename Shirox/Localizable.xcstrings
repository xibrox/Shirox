        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo titolo è collegato ad AniList e non ha sequel, prequel o storie parallele."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタイトルはAniListにリンクされており、続編・前日譚・外伝はありません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten tytuł jest powiązany z AniList i nie ma kontynuacji, prequeli ani historii pobocznych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este título está vinculado ao AniList e não tem sequências, prequels nem histórias paralelas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот тайтл связан с AniList и не имеет сиквелов, приквелов и побочных историй."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu başlık AniList'e bağlı ve devam filmi, öncül ya da yan hikâyesi yok."
