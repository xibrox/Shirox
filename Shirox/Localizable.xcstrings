        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk + untuk membuat koleksi, lalu tambahkan judul ke dalamnya dari pustaka Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
