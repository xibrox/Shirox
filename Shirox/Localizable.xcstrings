    "settings.runs_the_page_slider_click" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt den Seitenregler und die Kapitel-Buttons von rechts nach links laufen und tauscht die Klickseiten entsprechend."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs the page slider and the chapter buttons from right to left, and swaps the click sides with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invierte el deslizador de páginas y los botones de capítulo de derecha a izquierda, e intercambia con ellos los lados de clic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait fonctionner le curseur de page et les boutons de chapitre de droite à gauche, et inverse avec eux les côtés de clic."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjalankan penggeser halaman dan tombol bab dari kanan ke kiri, dan menukar sisi klik bersamanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa scorrere il cursore delle pagine e i pulsanti dei capitoli da destra a sinistra, e inverte con loro i lati del clic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページスライダとチャプターボタンを右から左の配置にし、それに合わせてクリックする側も入れ替えます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwa suwak stron i przyciski rozdziałów od prawej do lewej oraz zamienia z nimi strony kliknięć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inverte o controle de páginas e os botões de capítulo, da direita para a esquerda, e troca com eles os lados do clique."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключает ползунок страниц и кнопки глав справа налево и меняет местами стороны щелчка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayfa kaydırıcısını ve bölüm düğmelerini sağdan sola çalıştırır ve tıklama taraflarını bunlarla birlikte değiştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạy thanh trượt trang và các nút chương từ phải sang trái, đồng thời đổi các cạnh nhấp tương ứng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让页面滑块和章节按钮从右到左运行，并同时对调点按侧。"
          }
        }
      }
    },
