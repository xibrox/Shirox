    "jellyfin.connect_detail_mac" : {
      "comment" : "JellyfinConnectView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib diese Adresse sowie deinen Jellyfin-Benutzernamen und dein Passwort in diesem Bildschirm ein und klicke auf „Verbinden“. Deine Mediatheken erscheinen dann in Shirox."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type that address and your Jellyfin username and password into this screen and click Connect. Your libraries then show up in Shirox."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe esa dirección y tu nombre de usuario y contraseña de Jellyfin en esta pantalla y haz clic en Conectar. Tus bibliotecas aparecerán en Shirox."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez cette adresse ainsi que votre nom d’utilisateur et votre mot de passe Jellyfin dans cet écran, puis cliquez sur Se connecter. Vos bibliothèques apparaissent ensuite dans Shirox."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik alamat tersebut beserta nama pengguna dan kata sandi Jellyfin Anda ke layar ini, lalu klik Hubungkan. Pustaka Anda kemudian akan muncul di Shirox."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci quell'indirizzo, il tuo nome utente e la tua password di Jellyfin in questa schermata e fai clic su Connetti. Le tue librerie compariranno poi in Shirox."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのアドレスとJellyfinのユーザ名・パスワードをこの画面に入力し、「接続」をクリックします。ライブラリがShiroxに表示されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz ten adres oraz swoją nazwę użytkownika i hasło Jellyfin na tym ekranie i kliknij Połącz. Twoje biblioteki pojawią się wtedy w Shirox."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite esse endereço e seu nome de usuário e senha do Jellyfin nesta tela e clique em Conectar. Suas bibliotecas aparecerão no Shirox."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите этот адрес, а также имя пользователя и пароль Jellyfin на этом экране и нажмите «Подключиться». Затем ваши медиатеки появятся в Shirox."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu adresi ve Jellyfin kullanıcı adınızı ve parolanızı bu ekrana yazıp Bağlan'a tıklayın. Kitaplıklarınız ardından Shirox'ta görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập địa chỉ đó cùng tên người dùng và mật khẩu Jellyfin của bạn vào màn hình này rồi nhấp vào Kết nối. Sau đó, các thư viện của bạn sẽ hiện trong Shirox."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在此屏幕中输入该地址以及你的 Jellyfin 用户名和密码，然后点按“连接”。之后你的资料库就会显示在 Shirox 中。"
          }
        }
      }
    },
