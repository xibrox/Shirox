    "settings.tracks_your_anime_shows_and" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trackt deine Anime, Serien und Filme auf Simkl neben AniList und MyAnimeList. Simkl hat keine Manga."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracks your anime, shows and movies on Simkl alongside AniList and MyAnimeList. Simkl has no manga."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue tus animes, series y películas en Simkl junto con AniList y MyAnimeList. Simkl no tiene manga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suit vos animes, séries et films sur Simkl en plus d’AniList et de MyAnimeList. Simkl n’a pas de manga."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melacak anime, serial, dan film Anda di Simkl bersama AniList dan MyAnimeList. Simkl tidak memiliki manga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traccia i tuoi anime, serie e film su Simkl insieme ad AniList e MyAnimeList. Simkl non ha manga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniListとMyAnimeListに加えて、アニメ、番組、映画をSimklでトラッキングします。Simklにはマンガはありません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledzi Twoje anime, seriale i filmy w Simkl obok AniList i MyAnimeList. Simkl nie ma mangi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanha seus animes, séries e filmes no Simkl junto com o AniList e o MyAnimeList. O Simkl não tem mangá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отслеживает ваши аниме, сериалы и фильмы в Simkl наряду с AniList и MyAnimeList. В Simkl нет манги."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anime, dizi ve filmlerinizi AniList ve MyAnimeList'in yanı sıra Simkl'de de takip eder. Simkl'de manga yoktur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo dõi anime, chương trình và phim của bạn trên Simkl cùng với AniList và MyAnimeList. Simkl không có manga."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Simkl 上追踪你的动画、剧集和电影，与 AniList 和 MyAnimeList 并行。Simkl 没有漫画。"
          }
        }
      }
    },
    "settings.turn_pages_with_a_curl" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blättere Seiten in den seitenweisen Lesemodi mit einer Wölbung um, wie in einem Buch. Schalte es aus, um sie stattdessen zu schieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn pages with a curl, like a book, in the paged reading modes. Turn off to slide them instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa las páginas con un efecto de curvatura, como un libro, en los modos de lectura paginados. Desactívalo para deslizarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tourne les pages avec un effet de page cornée, comme un livre, dans les modes de lecture paginés. Désactivez pour les faire glisser à la place."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balik halaman dengan efek lipatan, seperti buku, pada mode membaca berhalaman. Matikan untuk menggeser halaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volta le pagine con un effetto sfoglio, come un libro, nelle modalità di lettura a pagine. Disattiva per farle scorrere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページ単位の読み方モードで、本のようにページをめくる（カール）アニメーションにします。オフにするとスライドになります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewracaj strony z efektem zawijania, jak w książce, w trybach czytania ze stronicowaniem. Wyłącz, aby przesuwać je zamiast tego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vire as páginas com um efeito de dobra, como um livro, nos modos de leitura paginados. Desative para deslizá-las."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перелистывайте страницы с эффектом загиба, как в книге, в постраничных режимах чтения. Выключите, чтобы страницы сдвигались."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayfalı okuma modlarında sayfaları kitap gibi kıvırarak çevirin. Kaydırarak geçmek için kapatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lật trang với hiệu ứng cuộn như một cuốn sách trong các chế độ đọc phân trang. Hãy tắt để trượt trang thay thế."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在分页阅读模式下，以卷页效果像书一样翻页。关闭后改为滑动翻页。"
          }
        }
      }
    },
