          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルは常に表示されます。共有する情報を減らすには、これらをオフにしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
