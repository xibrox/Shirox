    "settings.a_click_anywhere_on_a" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Klick irgendwo auf eine Seite blendet die Steuerelemente ein und aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A click anywhere on a page shows and hides the controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic en cualquier parte de la página muestra y oculta los controles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic n’importe où sur une page affiche et masque les commandes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik di mana saja pada halaman akan menampilkan dan menyembunyikan kontrol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic in un punto qualsiasi della pagina mostra e nasconde i controlli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページ上のどこかをクリックすると、コントロールの表示/非表示が切り替わります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknięcie w dowolnym miejscu strony pokazuje i ukrywa elementy sterujące."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um clique em qualquer lugar da página mostra e oculta os controles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щелчок в любом месте страницы показывает и скрывает элементы управления."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
