    "settings.buttons_switches_and_highlights_monochrome" : {
      "comment" : "GeneralSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasten, Schalter und Hervorhebungen. Monochrom hält Shirox schwarz-weiß; die Farben passen sich an den hellen und dunklen Modus an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buttons, switches and highlights. Monochrome keeps Shirox black and white; the colors adjust themselves to light and dark mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botones, interruptores y resaltados. Monocromo mantiene Shirox en blanco y negro; los colores se adaptan solos al modo claro y oscuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boutons, commutateurs et éléments en surbrillance. Monochrome garde Shirox en noir et blanc ; les couleurs s’adaptent d’elles-mêmes au mode clair et au mode sombre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol, sakelar, dan sorotan. Monokrom menjaga Shirox tetap hitam putih; warna menyesuaikan diri dengan mode terang dan gelap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsanti, interruttori ed elementi evidenziati. Monocromatico mantiene Shirox in bianco e nero; i colori si adattano da soli alla modalità chiara e scura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボタン、スイッチ、ハイライトの色です。モノクロではShiroxが白黒になります。カラーはライトモードとダークモードに合わせて自動調整されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyciski, przełączniki i wyróżnienia. Tryb monochromatyczny zachowuje czarno-biały wygląd Shirox; kolory dostosowują się do trybu jasnego i ciemnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Botões, chaves e destaques. Monocromático mantém o Shirox em preto e branco; as cores se ajustam sozinhas ao modo claro e escuro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопки, переключатели и выделения. Монохромный вариант оставляет Shirox чёрно-белым; цвета сами подстраиваются под светлый и тёмный режимы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düğmeler, anahtarlar ve vurgular. Tek Renk, Shirox'u siyah beyaz tutar; renkler açık ve koyu moda göre kendilerini ayarlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nút, công tắc và phần đánh dấu. Đơn sắc giữ Shirox ở màu đen trắng; các màu tự điều chỉnh theo chế độ sáng và tối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按钮、开关和高亮。单色会让 Shirox 保持黑白；颜色会自动适应浅色和深色模式。"
          }
        }
      }
    },
