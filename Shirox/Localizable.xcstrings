          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel link ha risposto con l'errore %lld. Controlla di averlo copiato per intero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのリンクはエラー%lldを返しました。すべてコピーされているか確認してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
