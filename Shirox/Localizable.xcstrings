    "settings.on_couldnt_be_matched_against %lld %@ %@" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld auf %2$@ konnten nicht mit %3$@ abgeglichen werden und werden daher behalten statt gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld on %2$@ couldn't be matched against %3$@, so they're kept rather than deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld en %2$@ no se pudieron emparejar con %3$@, así que se conservan en lugar de eliminarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld sur %2$@ n’ont pas pu être associés à %3$@ ; ils sont donc conservés plutôt que supprimés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld di %2$@ tidak dapat dicocokkan dengan %3$@, sehingga disimpan, bukan dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld su %2$@ non hanno potuto essere abbinati a %3$@, quindi vengono conservati anziché eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@の%1$lld件を%3$@と照合できなかったため、削除せずに保持します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozycji w %2$@, których nie dopasowano do %3$@: %1$lld — zostały zachowane zamiast usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld em %2$@ não puderam ser associados a %3$@, então foram mantidos em vez de excluídos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сопоставить %1$lld в %2$@ с %3$@, поэтому они сохранены, а не удалены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ üzerindeki %1$lld öğe %3$@ ile eşleştirilemedi, bu yüzden silinmek yerine korundu."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld mục trên %2$@ không thể khớp với %3$@, nên được giữ lại thay vì bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 上有 %1$lld 项无法与 %3$@ 匹配，因此予以保留而非删除。"
          }
        }
      }
    },
