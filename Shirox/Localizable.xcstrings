          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кадр сохранён в «Фото». Разрешите полный доступ в настройках, чтобы использовать альбом Shirox."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kare Fotoğraflar'a kaydedildi. Shirox albümünü kullanmak için Ayarlar'da Tam Erişime izin verin."
