        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bingkai disimpan ke Foto. Izinkan Akses Penuh di Pengaturan untuk menggunakan album Shirox."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotogramma salvato in Foto. Consenti l'accesso completo in Impostazioni per usare l'album Shirox."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フレームを「写真」に保存しました。Shiroxアルバムを使用するには、「設定」でフルアクセスを許可してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klatka zapisana w Zdjęciach. Zezwól na pełny dostęp w Ustawieniach, aby używać albumu Shirox."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
