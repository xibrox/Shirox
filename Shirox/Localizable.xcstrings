    "settings.cinematic_note" : {
      "comment" : "GeneralSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Artwork füllt das Fenster, und die Reihen der Startseite oder die Details einer Serie scrollen darüber. Schalte es aus, um auf der Startseite das Banner mit den Reihen darunter und bei einer Serie das Poster über der Folgenliste zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The artwork fills the window, with Home's rows or a show's details scrolling up over it. Turn off for Home's banner with the rows under it, and a show's poster above its episode list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ilustración llena la ventana y las filas del Inicio o los detalles de una serie se desplazan sobre ella. Desactívalo para ver el banner del Inicio con las filas debajo y el póster de una serie sobre su lista de episodios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’illustration remplit la fenêtre, et les rangées de l’accueil ou les détails d’une série défilent par-dessus. Désactivez pour obtenir la bannière de l’accueil avec les rangées en dessous, et l’affiche d’une série au-dessus de sa liste d’épisodes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar mengisi jendela, dengan baris Beranda atau detail serial bergulir naik di atasnya. Matikan untuk banner Beranda dengan baris di bawahnya, serta poster serial di atas daftar episodenya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'immagine riempie la finestra, con le righe della Home o i dettagli di una serie che scorrono sopra. Disattiva per avere il banner della Home con le righe sotto e la locandina di una serie sopra l'elenco degli episodi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アートワークがウインドウ全体に表示され、ホームの行や作品の詳細がその上にスクロールします。オフにすると、ホームではバナーの下に行が表示され、作品ではエピソードリストの上にポスターが表示されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafika wypełnia okno, a wiersze ekranu głównego lub szczegóły serialu przewijają się nad nią. Wyłącz, aby zobaczyć baner ekranu głównego z wierszami pod spodem oraz plakat serialu nad listą odcinków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A arte ocupa a janela, com as fileiras do Início ou os detalhes de uma série rolando por cima. Desative para ter o banner do Início com as fileiras abaixo e, nos detalhes, o pôster acima da lista de episódios."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обложка заполняет окно, а строки главной или сведения о сериале прокручиваются поверх неё. Выключите, чтобы показывать баннер главной со строками под ним и постер сериала над списком серий."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapak görseli pencereyi doldurur; Ana Sayfa'nın satırları veya bir dizinin ayrıntıları üzerinde yukarı kayar. Kapalıyken Ana Sayfa'da banner ve altında satırlar, dizi sayfasında bölüm listesinin üstünde poster görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh nghệ thuật lấp đầy cửa sổ, còn các hàng của Trang chủ hoặc chi tiết của một chương trình cuộn lên phía trên. Hãy tắt để dùng biểu ngữ của Trang chủ với các hàng bên dưới, và poster của chương trình phía trên danh sách tập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "海报图会铺满窗口，主页的行或作品详情会在其上方滚动。关闭后，主页显示横幅，行位于其下方，作品详情则在剧集列表上方显示海报。"
          }
        }
      }
    },
