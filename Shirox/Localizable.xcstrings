    "detail.this_source_is_protected_by" : {
      "comment" : "StreamPickerView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Quelle ist durch Cloudflare geschützt. Bestätige, um Streams zu laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This source is protected by Cloudflare. Verify to load streams."
