        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotograma guardado en Fotos. Permite el acceso completo en Ajustes para usar el álbum Shirox."
          }
        },
        "fr" : {
          "stringUnit" : {
