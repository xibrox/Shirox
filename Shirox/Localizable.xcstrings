    "settings.which_rendition_to_start_on" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit welcher Variante gestartet wird, wenn ein Stream mehrere anbietet. Automatisch lässt den Player sich an deine Verbindung anpassen; eine feste Auswahl weicht auf die nächstgelegene verfügbare aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which rendition to start on when a stream offers several. Auto lets the player adapt to your connection; a fixed choice falls back to the closest available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué versión usar al empezar cuando un stream ofrece varias. Auto deja que el reproductor se adapte a tu conexión; una elección fija usa la más cercana disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version avec laquelle démarrer quand un flux en propose plusieurs. Auto laisse le lecteur s’adapter à votre connexion ; un choix fixe se rabat sur la plus proche disponible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendisi mana yang dimulai saat stream menawarkan beberapa pilihan. Otomatis membiarkan pemutar menyesuaikan dengan koneksi Anda; pilihan tetap beralih ke yang terdekat yang tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale versione usare all'inizio quando uno stream ne offre diverse. Auto lascia che il player si adatti alla tua connessione; una scelta fissa ripiega sulla più vicina disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストリームが複数の画質を提供する場合に、どの画質で開始するかを選びます。「自動」では接続状況に合わせてプレーヤが調整し、固定した場合は利用可能な最も近い画質になります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na której wersji zacząć, gdy strumień oferuje kilka. Auto pozwala odtwarzaczowi dostosować się do połączenia; stały wybór przechodzi do najbliższej dostępnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual versão usar ao iniciar quando um stream oferece várias. Auto deixa o player se adaptar à sua conexão; uma escolha fixa recorre à mais próxima disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С какого варианта начинать, если поток предлагает несколько. «Авто» позволяет плееру подстраиваться под ваше соединение; при фиксированном выборе берётся ближайший доступный."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yayın birden fazla seçenek sunduğunda hangi sürümle başlanacağı. Otomatik, oynatıcının bağlantınıza uyum sağlamasını sağlar; sabit bir seçim, mevcut en yakın olana geçer."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên bản để bắt đầu khi một luồng cung cấp nhiều phiên bản. Tự động để trình phát thích ứng với kết nối của bạn; lựa chọn cố định sẽ lùi về phiên bản gần nhất có sẵn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当串流提供多个版本时，从哪个版本开始播放。“自动”让播放器适应你的网络；固定选择在不可用时会回退到最接近的版本。"
          }
        }
      }
    },
