    "settings.discord_rich_presence_note" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während ein Video läuft oder ein Manga geöffnet ist, zeigt dein Discord-Status den Titel, die Folge oder das Kapitel und das Cover. Aus wird nichts an Discord gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While a video plays or a manga is open, your Discord status shows its title, the episode or chapter and the cover. Off, nothing is sent to Discord."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras se reproduce un vídeo o hay un manga abierto, tu estado de Discord muestra su título, el episodio o capítulo y la portada. Si está desactivado, no se envía nada a Discord."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la lecture d’une vidéo ou l’ouverture d’un manga, votre statut Discord affiche son titre, l’épisode ou le chapitre et la couverture. Désactivé, rien n’est envoyé à Discord."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat video diputar atau manga dibuka, status Discord-mu menampilkan judul, episode atau bab, dan sampulnya. Jika nonaktif, tidak ada yang dikirim ke Discord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre un video è in riproduzione o un manga è aperto, il tuo stato su Discord mostra il titolo, l’episodio o il capitolo e la copertina. Se disattivato, non viene inviato nulla a Discord."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画の再生中やマンガを開いている間、Discordのステータスにタイトル、エピソードまたはチャプター、カバーが表示されます。オフの場合、Discordには何も送信されません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy odtwarzany jest film lub otwarta jest manga, Twój status na Discordzie pokazuje tytuł, odcinek lub rozdział oraz okładkę. Gdy wyłączone, nic nie jest wysyłane do Discorda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto um vídeo é reproduzido ou um mangá está aberto, seu status do Discord mostra o título, o episódio ou capítulo e a capa. Desativado, nada é enviado ao Discord."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока воспроизводится видео или открыта манга, ваш статус в Discord показывает название, серию или главу и обложку. Если выключено, в Discord ничего не отправляется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir video oynatılırken veya bir manga açıkken Discord durumun başlığı, bölümü ve kapağı gösterir. Kapalıyken Discord'a hiçbir şey gönderilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi đang phát video hoặc mở manga, trạng thái Discord của bạn hiển thị tiêu đề, tập hoặc chương và ảnh bìa. Khi tắt, không có gì được gửi đến Discord."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放视频或打开漫画时，你的 Discord 状态会显示标题、集数或章节以及封面。关闭后，不会向 Discord 发送任何内容。"
          }
        }
      }
    },
