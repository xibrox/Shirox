    "settings.shadow_is_a_soft_dark" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schatten ist ein weicher dunkler Schein um den Text, für helle Szenen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shadow is a soft dark glow around the text, for bright scenes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sombra es un suave resplandor oscuro alrededor del texto, para escenas brillantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ombre est une douce lueur sombre autour du texte, pour les scènes lumineuses."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayangan adalah cahaya gelap lembut di sekitar teks, untuk adegan yang terang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ombra è un morbido alone scuro attorno al testo, per le scene luminose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影は、明るいシーン向けの、文字の周囲のやわらかな暗い光です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cień to miękka ciemna poświata wokół tekstu, przydatna w jasnych scenach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sombra é um brilho escuro e suave ao redor do texto, para cenas claras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тень — мягкое тёмное свечение вокруг текста для ярких сцен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gölge, parlak sahneler için metnin çevresinde yumuşak, koyu bir parıltıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bóng đổ là quầng sáng tối mềm quanh văn bản, dành cho các cảnh sáng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阴影是文字周围柔和的深色光晕，适用于明亮的场景。"
          }
        }
      }
