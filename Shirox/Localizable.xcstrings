    "settings.downloaded_episodes_and_chapters_arent" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geladene Folgen und Kapitel sind kein Cache, daher lässt „Alles löschen“ sie in Ruhe. Lösche einzelne Folgen im Downloads-Tab oder schalte „Nach dem Ansehen löschen“ in den Download-Einstellungen ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloaded episodes and chapters aren't a cache, so Clear Everything leaves them alone. Delete single episodes from the Downloads tab, or turn on Delete After Watching in Download Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios y capítulos descargados no son una caché, así que Borrar todo no los toca. Elimina episodios sueltos desde la pestaña Descargas o activa Eliminar tras ver en Ajustes de descarga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épisodes et chapitres téléchargés ne sont pas un cache ; « Tout effacer » n’y touche donc pas. Supprimez des épisodes individuels depuis l’onglet Téléchargements, ou activez « Supprimer après visionnage » dans les réglages des téléchargements."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episode dan bab yang diunduh bukan cache, jadi Hapus Semuanya tidak menyentuhnya. Hapus episode satu per satu dari tab Unduhan, atau aktifkan Hapus Setelah Menonton di Pengaturan Unduhan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli episodi e i capitoli scaricati non sono una cache, quindi Cancella tutto non li tocca. Elimina i singoli episodi dalla scheda Download oppure attiva Elimina dopo la visione in Impostazioni download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みのエピソードとチャプターはキャッシュではないため、「すべてを消去」では削除されません。個々のエピソードは「ダウンロード」タブから削除するか、ダウンロード設定で「視聴後に削除」をオンにしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobrane odcinki i rozdziały nie są pamięcią podręczną, więc Wyczyść wszystko ich nie dotyka. Usuwaj pojedyncze odcinki w zakładce Pobrane lub włącz Usuń po obejrzeniu w Ustawieniach pobierania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episódios e capítulos baixados não são cache, então Limpar tudo não os afeta. Exclua episódios individuais na aba Downloads ou ative Excluir após assistir em Ajustes de download."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загруженные серии и главы — это не кэш, поэтому «Очистить всё» их не затрагивает. Удаляйте отдельные серии на вкладке «Загрузки» или включите «Удалять после просмотра» в настройках загрузки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen bölümler önbellek değildir; bu yüzden Her Şeyi Temizle onlara dokunmaz. Tek tek bölümleri İndirilenler sekmesinden silin veya İndirme Ayarları'nda İzledikten Sonra Sil'i açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tập và chương đã tải xuống không phải là bộ nhớ đệm, nên Xóa mọi thứ sẽ không đụng đến chúng. Hãy xóa từng tập trong tab Tải xuống, hoặc bật Xóa sau khi xem trong Cài đặt tải xuống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已下载的剧集和章节不属于缓存，因此“清除全部内容”不会处理它们。请在“下载”标签页中删除单个剧集，或在“下载设置”中开启“观看后删除”。"
          }
        }
      }
    },
    "settings.drag_to_reorder_settings_always" : {
      "comment" : "GeneralSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Sortieren ziehen. Einstellungen bleibt immer, damit ausgeblendete Tabs zurückkommen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to reorder. Settings always stays, so hidden tabs can come back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para reordenar. Ajustes siempre se queda, para que las pestañas ocultas puedan volver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réorganiser. Réglages reste toujours présent, afin que les onglets masqués puissent revenir."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret untuk mengubah urutan. Pengaturan selalu tetap ada, sehingga tab yang disembunyikan dapat dikembalikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per riordinare. Impostazioni resta sempre, così le schede nascoste possono tornare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして並べ替えます。「設定」は常に残るため、非表示にしたタブを元に戻せます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
