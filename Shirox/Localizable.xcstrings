    "profile.without_a_picture_the_profile" : {
      "comment" : "ProfilesView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Bild nutzt das Profil sein AniList-Bild, dann das von MyAnimeList, dann das von Simkl, sonst seinen Anfangsbuchstaben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a picture, the profile uses its AniList picture, then MyAnimeList's, then Simkl's, or else its initial."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin imagen, el perfil usa la de AniList, luego la de MyAnimeList, luego la de Simkl, o si no su inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans image, le profil utilise son image AniList, puis celle de MyAnimeList, puis celle de Simkl, ou sinon son initiale."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa gambar, profil menggunakan gambar AniList-nya, lalu MyAnimeList, lalu Simkl, atau inisialnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza un'immagine, il profilo usa quella di AniList, poi quella di MyAnimeList, poi quella di Simkl, altrimenti la sua iniziale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真がない場合、プロフィールにはAniList、MyAnimeList、Simklの順で写真が使われ、どれもなければイニシャルが表示されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez zdjęcia profil używa zdjęcia z AniList, następnie z MyAnimeList, potem z Simkl, a w ostateczności inicjału."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem imagem, o perfil usa a imagem do AniList, depois a do MyAnimeList, depois a do Simkl, ou então a inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без изображения профиль использует изображение из AniList, затем из MyAnimeList, затем из Simkl, а иначе — свою первую букву."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resim yoksa profil sırasıyla AniList resmini, sonra MyAnimeList'inkini, sonra Simkl'inkini, o da yoksa baş harfini kullanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu không có ảnh, hồ sơ sẽ dùng ảnh AniList, rồi đến ảnh MyAnimeList, rồi ảnh Simkl, hoặc nếu không thì dùng chữ cái đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有图片时，个人资料会使用其 AniList 图片，其次是 MyAnimeList 的，再其次是 Simkl 的，否则使用其首字母。"
          }
        }
      }
    },
