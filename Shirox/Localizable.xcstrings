    "detail.newest_episodes_first_show_oldest" : {
      "comment" : "AniListDetailView, DetailView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neueste Folgen zuerst – älteste zuerst anzeigen"
          }
