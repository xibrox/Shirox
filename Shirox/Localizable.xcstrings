    "settings.sends_app_module_and_web" : {
      "comment" : "AdvancedNetworkSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leitet Anfragen von App, Modulen und Web-Ansichten über einen HTTP-CONNECT- oder SOCKS5-Proxy. Nicht für Videos. Solange er ausfällt, geht nichts direkt raus. Gilt nach einem Neustart."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends app, module and web view requests through an HTTP CONNECT or SOCKS5 proxy. Not for video. Nothing goes out directly while it's down. Applies after a restart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía las peticiones de la app, los módulos y las vistas web a través de un proxy HTTP CONNECT o SOCKS5. No se aplica a vídeo. No sale nada directamente mientras esté caído. Se aplica tras reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie les requêtes de l’app, des modules et des vues web via un proxy HTTP CONNECT ou SOCKS5. Ne concerne pas la vidéo. Rien ne sort directement tant qu’il est hors service. S’applique après un redémarrage."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengirim permintaan app, modul, dan tampilan web melalui proxy HTTP CONNECT atau SOCKS5. Tidak untuk video. Tidak ada yang keluar secara langsung saat proxy mati. Berlaku setelah dimulai ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia le richieste di app, moduli e viste web tramite un proxy HTTP CONNECT o SOCKS5. Non vale per i video. Mentre è inattivo non esce nulla direttamente. Si applica dopo un riavvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App、モジュール、Webビューのリクエストを、HTTP CONNECTまたはSOCKS5プロキシ経由で送信します。ビデオには適用されません。プロキシが停止している間は、直接送信されません。再起動後に反映されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyła żądania aplikacji, modułów i widoków internetowych przez serwer proxy HTTP CONNECT lub SOCKS5. Nie dotyczy wideo. Gdy serwer nie działa, nic nie jest wysyłane bezpośrednio. Zacznie obowiązywać po ponownym uruchomieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia as requisições do app, dos módulos e das visualizações web por um proxy HTTP CONNECT ou SOCKS5. Não vale para vídeo. Nada sai diretamente enquanto ele estiver fora do ar. Vale após reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет запросы приложения, модулей и веб-просмотра через прокси HTTP CONNECT или SOCKS5. Не для видео. Пока прокси недоступен, напрямую ничего не отправляется. Применяется после перезапуска."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama, modül ve web görünümü isteklerini bir HTTP CONNECT veya SOCKS5 proxy'si üzerinden gönderir. Video için değildir. Kapalıyken hiçbir şey doğrudan gitmez. Yeniden başlatmadan sonra uygulanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi các yêu cầu của ứng dụng, mô-đun và chế độ xem web qua proxy HTTP CONNECT hoặc SOCKS5. Không dành cho video. Khi proxy ngừng hoạt động, sẽ không có gì được gửi trực tiếp. Có hiệu lực sau khi khởi động lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 HTTP CONNECT 或 SOCKS5 代理发送 App、模块和网页视图的请求。不适用于视频。代理不可用时，不会有任何请求直接发出。重新启动后生效。"
          }
        }
      }
    },
