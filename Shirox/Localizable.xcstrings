    "modules.optional_a_modules_json_fills" : {
      "comment" : "ModuleImportView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Die .json eines Moduls füllt die Details unten aus; du kannst sie trotzdem ändern. Das Skript oben wird in jedem Fall benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. A module's .json fills in the details below; you can still change them. The script above is needed either way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. El .json de un módulo rellena los detalles de abajo; aun así puedes cambiarlos. El script de arriba hace falta en cualquier caso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facultatif. Le .json d’un module renseigne les détails ci-dessous ; vous pouvez toujours les modifier. Le script ci-dessus est nécessaire dans tous les cas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opsional. File .json modul mengisi detail di bawah; Anda tetap dapat mengubahnya. Skrip di atas tetap diperlukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facoltativo. Il .json di un modulo compila i dettagli qui sotto, che puoi comunque modificare. Lo script qui sopra serve in ogni caso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意。モジュールの.jsonから以下の詳細が入力されます。変更することもできます。どちらの場合も、上のスクリプトが必要です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalne. Plik .json modułu wypełnia poniższe szczegóły; nadal możesz je zmienić. Skrypt powyżej jest potrzebny w obu przypadkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. O .json de um módulo preenche os detalhes abaixo; você ainda pode alterá-los. O script acima é necessário de qualquer forma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательно. Файл .json модуля заполняет сведения ниже, их всё равно можно изменить. Скрипт выше нужен в любом случае."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsteğe bağlı. Bir modülün .json dosyası aşağıdaki ayrıntıları doldurur; yine de değiştirebilirsiniz. Yukarıdaki komut dosyası her durumda gereklidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
