        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此来源受 Cloudflare 保护。请验证以载入串流。"
          }
        }
      }
    },
    "detail.this_title_is_linked_to" : {
      "comment" : "DetailView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Titel ist mit AniList verknüpft und hat keine Fortsetzungen, Vorgeschichten oder Nebengeschichten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This title is linked to AniList and has no sequels, prequels or side stories."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este título está vinculado a AniList y no tiene secuelas, precuelas ni historias paralelas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce titre est associé à AniList et n’a ni suite, ni préquelle, ni histoire annexe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judul ini tertaut ke AniList dan tidak memiliki sekuel, prekuel, atau cerita sampingan."
