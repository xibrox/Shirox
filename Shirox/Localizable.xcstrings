          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Матовые стеклянные кнопки в видеоплеере. Выключите для сплошных элементов управления."
          }
        },
        "tr" : {
          "stringUnit" : {
