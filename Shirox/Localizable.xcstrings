        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij +, aby utworzyć kolekcję, a następnie dodaj do niej tytuły ze swojej biblioteki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em + para criar uma coleção e adicione títulos a ela a partir da sua biblioteca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите +, чтобы создать коллекцию, затем добавьте в неё тайтлы из медиатеки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
