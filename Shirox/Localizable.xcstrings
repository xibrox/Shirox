    "modules.was_added_but_a_test %@ %@ %@" : {
      "comment" : "ModuleListView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde hinzugefügt, aber ein Testlauf ist bei %2$@ fehlgeschlagen: %3$@. Es ist eventuell defekt oder für eine andere App gemacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ was added, but a test run failed at %2$@: %3$@. It may be broken or made for another app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se añadió %1$@, pero una prueba falló en %2$@: %3$@. Puede estar roto o hecho para otra app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a été ajouté, mais un test a échoué à %2$@ : %3$@. Il est peut-être défectueux ou conçu pour une autre app."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ telah ditambahkan, tetapi uji coba gagal di %2$@: %3$@. Mungkin rusak atau dibuat untuk aplikasi lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è stato aggiunto, ma un test è fallito in %2$@: %3$@. Potrebbe essere difettoso o creato per un'altra app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@を追加しましたが、テスト実行が%2$@で失敗しました: %3$@。壊れているか、別のアプリ向けの可能性があります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodano %1$@, ale próbne uruchomienie nie powiodło się na etapie %2$@: %3$@. Moduł może być uszkodzony lub przeznaczony dla innej aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ foi adicionado, mas uma execução de teste falhou em %2$@: %3$@. Ele pode estar com defeito ou ter sido feito para outro app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» добавлен, но тестовый запуск завершился ошибкой на этапе «%2$@»: %3$@. Возможно, он неисправен или создан для другого приложения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ eklendi, ancak bir test çalıştırması %2$@ adımında başarısız oldu: %3$@. Bozuk olabilir veya başka bir uygulama için yapılmış olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đã được thêm, nhưng lần chạy thử không thành công tại %2$@: %3$@. Mô-đun có thể bị hỏng hoặc được tạo cho ứng dụng khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已添加 %1$@，但测试运行在 %2$@ 处失败：%3$@。它可能已损坏，或是为其他 App 制作的。"
          }
        }
      }
    },
