    "settings.an_edit_you_make_to" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Änderung an einem Titel — Status, Fortschritt, Bewertung oder das Entfernen — wird auch in jeden anderen hier eingeschalteten Dienst geschrieben. Ausgeschaltete Dienste ändern sich nur durch die Synchronisierungen unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An edit you make to a title — its status, progress, score, or removing it — is also written to every other service switched on here. Services left off change only through the sync runs below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una edición que haces en un título (su estado, progreso, puntuación o su eliminación) también se escribe en todos los demás servicios activados aquí. Los servicios desactivados solo cambian mediante las sincronizaciones de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une modification que vous apportez à un titre — son statut, sa progression, sa note ou sa suppression — est aussi écrite sur tous les autres services activés ici. Les services désactivés ne changent que via les synchronisations ci-dessous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan yang Anda buat pada sebuah judul — status, progres, skor, atau penghapusannya — juga ditulis ke setiap layanan lain yang diaktifkan di sini. Layanan yang dimatikan hanya berubah melalui sinkronisasi di bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una modifica che fai a un titolo (stato, progresso, punteggio o rimozione) viene scritta anche su ogni altro servizio attivato qui. I servizi lasciati disattivati cambiano solo tramite le sincronizzazioni qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルに加えた編集（ステータス、進捗、スコア、削除）は、ここでオンになっている他のすべてのサービスにも書き込まれます。オフのサービスは、以下の同期実行でのみ変更されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana, którą wprowadzisz w tytule — jego status, postęp, ocena lub usunięcie — jest zapisywana także w każdym innym włączonym tutaj serwisie. Wyłączone serwisy zmieniają się tylko podczas synchronizacji poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma edição que você faz em um título — status, progresso, nota ou remoção — também é gravada em todos os outros serviços ativados aqui. Os serviços desativados só mudam por meio das sincronizações abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любое изменение тайтла — его статуса, прогресса, оценки или удаление — также записывается в каждый другой включённый здесь сервис. Выключенные сервисы меняются только при синхронизации ниже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir başlıkta yaptığınız düzenleme — durumu, ilerlemesi, puanı veya kaldırılması — burada açık olan diğer tüm hizmetlere de yazılır. Kapalı bırakılan hizmetler yalnızca aşağıdaki senkronizasyon çalıştırmalarıyla değişir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi chỉnh sửa bạn thực hiện với một tiêu đề — trạng thái, tiến độ, điểm hoặc việc gỡ tiêu đề — cũng được ghi vào mọi dịch vụ khác đang bật ở đây. Các dịch vụ đang tắt chỉ thay đổi thông qua các lần đồng bộ bên dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你对作品所做的编辑 — 状态、进度、评分或移除 — 也会写入此处开启的其他所有服务。关闭的服务仅通过下方的同步运行进行更改。"
          }
        }
      }
    },
