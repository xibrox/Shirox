    "shared.simkl_couldnt_be_reached_your" : {
      "comment" : "LibraryDataSource",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl war nicht erreichbar — deine Änderung ist gespeichert und wird später gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl couldn't be reached — your change is saved and will be sent later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con Simkl: tu cambio se ha guardado y se enviará más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl est injoignable — votre modification est enregistrée et sera envoyée plus tard."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl tidak dapat dijangkau — perubahan Anda tersimpan dan akan dikirim nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere Simkl: la tua modifica è salvata e verrà inviata più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simklに接続できませんでした — 変更は保存済みで、後で送信されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć z Simkl — Twoja zmiana została zapisana i zostanie wysłana później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar o Simkl — sua alteração foi salva e será enviada mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось связаться с Simkl — ваше изменение сохранено и будет отправлено позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl'e ulaşılamadı — değişikliğiniz kaydedildi ve daha sonra gönderilecek."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kết nối đến Simkl — thay đổi của bạn đã được lưu và sẽ được gửi sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到 Simkl — 你的更改已保存，稍后将发送。"
          }
        }
      }
    },
    "shared.simkls_daily_limit_for_your" : {
      "comment" : "SimklLibraryService",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tageslimit von Simkl für dein Konto ist erreicht. Es wird um Mitternacht US-Ostküstenzeit zurückgesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simkl's daily limit for your account has been reached. It resets at midnight US Eastern time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alcanzó el límite diario de Simkl para tu cuenta. Se restablece a medianoche, hora del este de EE. UU."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limite quotidienne de Simkl pour votre compte a été atteinte. Elle est réinitialisée à minuit, heure de l’Est des États-Unis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batas harian Simkl untuk akun Anda telah tercapai. Diatur ulang pada tengah malam waktu Timur AS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il limite giornaliero di Simkl per il tuo account è stato raggiunto. Si azzera a mezzanotte, ora della costa orientale degli Stati Uniti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントのSimklの1日の上限に達しました。米国東部時間の午前0時にリセットされます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osiągnięto dzienny limit Simkl dla Twojego konta. Zostanie zresetowany o północy czasu wschodnioamerykańskiego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O limite diário do Simkl para sua conta foi atingido. Ele é redefinido à meia-noite, no horário do leste dos EUA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достигнут дневной лимит Simkl для вашей учётной записи. Он сбрасывается в полночь по восточному времени США."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınız için Simkl'in günlük sınırına ulaşıldı. ABD Doğu saatiyle gece yarısı sıfırlanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã đạt giới hạn hằng ngày của Simkl cho tài khoản của bạn. Giới hạn đặt lại vào nửa đêm theo giờ miền Đông Hoa Kỳ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的账户已达到 Simkl 的每日上限。将在美国东部时间午夜重置。"
          }
        }
      }
    },
