    "settings.looks_up_servers_over_encrypted" : {
      "comment" : "AdvancedNetworkSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löst Server über verschlüsseltes DNS auf, für Netzwerke, die es manipulieren. Nicht für Videos oder Webansichten; ein DNS-Profil des Geräts oder ein VPN hat Vorrang. Gilt nach einem Neustart."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looks up servers over encrypted DNS, for networks that tamper with it. Not for video or web views; a device DNS profile or VPN comes first. Applies after a restart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca servidores con DNS cifrado, para redes que lo manipulan. No se aplica a vídeo ni a vistas web; un perfil de DNS del dispositivo o una VPN tienen prioridad. Se aplica tras reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche les serveurs via un DNS chiffré, pour les réseaux qui le falsifient. Ne concerne ni la vidéo ni les vues web ; un profil DNS de l’appareil ou un VPN est prioritaire. S’applique après un redémarrage."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencari server melalui DNS terenkripsi, untuk jaringan yang mengutak-atiknya. Tidak untuk video atau tampilan web; profil DNS perangkat atau VPN didahulukan. Berlaku setelah dimulai ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca i server tramite DNS cifrato, per le reti che lo manomettono. Non vale per video né viste web; un profilo DNS del dispositivo o una VPN hanno la precedenza. Si applica dopo un riavvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワークによる改ざんに備えて、暗号化DNSでサーバを検索します。ビデオやWebビューには適用されません。デバイスのDNSプロファイルやVPNが優先されます。再起動後に反映されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukuje serwery przez szyfrowany DNS, dla sieci, które go modyfikują. Nie dotyczy wideo ani widoków internetowych; profil DNS urządzenia lub VPN ma pierwszeństwo. Zacznie obowiązywać po ponownym uruchomieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta servidores por DNS criptografado, para redes que o adulteram. Não vale para vídeo nem visualizações web; um perfil de DNS do dispositivo ou uma VPN têm prioridade. Vale após reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ищет серверы через зашифрованный DNS — для сетей, которые его подменяют. Не для видео и веб-просмотра; профиль DNS устройства или VPN имеют приоритет. Применяется после перезапуска."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucuları, kurcalayan ağlar için şifreli DNS üzerinden bulur. Video veya web görünümleri için değildir; aygıt DNS profili veya VPN önceliklidir. Yeniden başlatmadan sonra uygulanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tra cứu máy chủ qua DNS mã hóa, dành cho các mạng can thiệp vào DNS. Không áp dụng cho video hay chế độ xem web; hồ sơ DNS của thiết bị hoặc VPN được ưu tiên hơn. Có hiệu lực sau khi khởi động lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过加密 DNS 查询服务器，适用于 DNS 被篡改的网络。不适用于视频或网页视图；设备 DNS 描述文件或 VPN 优先。重新启动后生效。"
          }
        }
      }
    },
