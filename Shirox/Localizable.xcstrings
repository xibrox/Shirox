    },
    "settings.a_frosted_circle_holds_the" : {
      "comment" : "GeneralSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein milchiger Kreis umgibt die Ladeanzeige, wie es bei Sheets schon immer ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frosted circle holds the spinner, as sheets always have."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un círculo esmerilado contiene el indicador de carga, como siempre en las hojas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cercle dépoli contient l’indicateur de progression, comme toujours dans les feuilles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingkaran buram menampung indikator pemuatan, seperti pada sheet selama ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cerchio smerigliato contiene l'indicatore di caricamento, come sempre nei fogli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シートと同じように、すりガラス状の円がスピナーを囲みます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskaźnik postępu znajduje się w półprzezroczystym kółku, tak jak zawsze w arkuszach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um círculo fosco envolve o indicador de carregamento, como sempre nas folhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Индикатор находится в матовом круге, как и раньше в панелях."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buzlu bir daire, sayfalarda her zaman olduğu gibi yükleme göstergesini tutar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một vòng tròn mờ chứa biểu tượng quay, như các trang tính luôn có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毛玻璃圆圈中显示加载指示器，与表单的一贯样式相同。"
          }
        }
      }
    },
    "settings.a_positive_delay_shows_subtitles" : {
      "comment" : "PlayerSubtitleSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine positive Verzögerung zeigt Untertitel früher an, eine negative später."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A positive delay shows subtitles sooner, a negative one later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un retraso positivo muestra los subtítulos antes; uno negativo, después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un décalage positif affiche les sous-titres plus tôt, un décalage négatif plus tard."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeda positif menampilkan subtitel lebih cepat, jeda negatif lebih lambat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ritardo positivo mostra i sottotitoli prima, uno negativo più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遅延を正の値にすると字幕が早く、負の値にすると遅く表示されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodatnie opóźnienie pokazuje napisy wcześniej, ujemne później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um atraso positivo mostra as legendas mais cedo; um negativo, mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положительная задержка показывает субтитры раньше, отрицательная — позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozitif gecikme altyazıları daha erken, negatif gecikme daha geç gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ trễ dương hiện phụ đề sớm hơn, độ trễ âm hiện muộn hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正延迟会让字幕提前显示，负延迟则让字幕延后显示。"
          }
        }
      }
    },
