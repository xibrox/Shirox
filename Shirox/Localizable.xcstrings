    "modules.file_replaces_editor" : {
      "comment" : "ModuleScriptEditorView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gesamte Inhalt des Editors wird durch das Skript der Datei ersetzt. Nichts wird übernommen, bis du auf „Speichern“ tippst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything in the editor is replaced with the file's script. Nothing is kept until you tap Save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el contenido del editor se sustituye por el script del archivo. No se guarda nada hasta que toques Guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le contenu de l’éditeur est remplacé par le script du fichier. Rien n’est conservé tant que vous n’avez pas touché Enregistrer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua isi editor akan diganti dengan skrip dari file. Tidak ada yang disimpan sampai Anda mengetuk Simpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il contenuto dell'editor viene sostituito con lo script del file. Non viene conservato nulla finché non tocchi Salva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディタの内容はすべてファイルのスクリプトに置き換えられます。「保存」をタップするまで何も保持されません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Całą zawartość edytora zastąpi skrypt z pliku. Nic nie zostanie zachowane, dopóki nie stukniesz Zachowaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo no editor é substituído pelo script do arquivo. Nada é mantido até você tocar em Salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё содержимое редактора будет заменено скриптом из файла. Ничего не сохраняется, пока вы не нажмёте «Сохранить»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenleyicideki her şey dosyanın komut dosyasıyla değiştirilir. Kaydet'e dokunana kadar hiçbir şey saklanmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi nội dung trong trình soạn thảo sẽ được thay bằng tập lệnh của tệp. Sẽ không có gì được giữ lại cho đến khi bạn chạm vào Lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑器中的所有内容都将被替换为该文件的脚本。在你点按“保存”之前，不会保留任何内容。"
          }
        }
      }
    },
